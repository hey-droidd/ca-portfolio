---
/**
 * DESIGN-2 entry — renders website.json `sections` in order.
 * Reorder or hide sections via config; no page rewrite needed.
 * Prospect-specific one-offs live in clients/<id>/custom/.
 */
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/design2/SiteHeader.astro';
import Hero from '../components/design2/Hero.astro';
import Trust from '../components/design2/Trust.astro';
import Expertise from '../components/design2/Expertise.astro';
import WhyJane from '../components/design2/WhyJane.astro';
import Approach from '../components/design2/Approach.astro';
import Experience from '../components/design2/Experience.astro';
import Industries from '../components/design2/Industries.astro';
import Testimonials from '../components/design2/Testimonials.astro';
import FaqProcess from '../components/design2/FaqProcess.astro';
import ContactCta from '../components/design2/ContactCta.astro';
import SiteFooter from '../components/design2/SiteFooter.astro';
import type { WebsiteConfig } from '../lib/design2/types';
import website from '../../clients/jane-doe/website.json';

const config = website as unknown as WebsiteConfig;
const { business, content, sections, seo } = config;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AccountingService',
      name: business.name,
      founder: { '@type': 'Person', name: business.principal, jobTitle: business.title },
      description: seo.description,
      email: business.email,
      telephone: business.phone,
      areaServed: business.areasServed,
    },
    {
      '@type': 'FAQPage',
      mainEntity: content.faq.items.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<Layout title={seo.title} description={seo.description} businessName={business.name} schema={schema}>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <SiteHeader business={business} />
  <main id="main-content">
    {sections.map((section) => {
      switch (section) {
        case 'hero':
          return <Hero hero={content.hero} />;
        case 'trust':
          return <Trust trust={content.trust} />;
        case 'expertise':
          return <Expertise expertise={content.expertise} contactHref={business.contactHref} />;
        case 'why':
          return <WhyJane why={content.why} />;
        case 'approach':
          return <Approach approach={content.approach} />;
        case 'experience':
          return <Experience experience={content.experience} />;
        case 'industries':
          return <Industries industries={content.industries} />;
        case 'testimonials':
          return <Testimonials testimonials={content.testimonials} />;
        case 'faq':
          return <FaqProcess faq={content.faq} business={business} />;
        case 'contact':
          return <ContactCta contact={content.contact} business={business} />;
        default:
          return null;
      }
    })}
  </main>
  <SiteFooter footer={content.footer} business={business} />
</Layout>
