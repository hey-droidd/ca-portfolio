---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  schemaMarkup?: object;
}

const {
  title = 'CA Shweta Verma | Chartered Accountant: Income Tax & GST Expert',
  description = 'CA Shweta Verma (B.Com, FCA, DISA, FAFD), practicing Chartered Accountant helping individuals & businesses navigate Income Tax, GST, and financial compliance with clarity.',
  ogImage = '/og-image.png',
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  schemaMarkup,
} = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://cashwetaverma.com/#person',
      name: 'Shweta Verma',
      honorificPrefix: 'CA',
      jobTitle: 'Chartered Accountant',
      hasCredential: ['B.Com', 'FCA', 'DISA', 'FAFD'],
      email: 'cashwetav0893@gmail.com',
      telephone: '+918130573445',
      url: 'https://cashwetaverma.com',
      sameAs: ['https://www.youtube.com/@cashwetaverma'],
      memberOf: {
        '@type': 'Organization',
        name: 'Institute of Chartered Accountants of India',
        alternateName: 'ICAI',
      },
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://cashwetaverma.com/#business',
      name: 'CA Shweta Verma',
      description: 'Practicing Chartered Accountant specialising in Income Tax, GST, TDS/TCS compliance, and financial advisory services.',
      url: 'https://cashwetaverma.com',
      email: 'cashwetav0893@gmail.com',
      telephone: '+918130573445',
      founder: { '@id': 'https://cashwetaverma.com/#person' },
      serviceType: [
        'Income Tax Filing',
        'GST Registration & Filing',
        'TDS/TCS Compliance',
        'Tax Notice Representation',
        'Business Registration',
        'NRI Taxation',
        'Financial Advisory',
      ],
      areaServed: {
        '@type': 'Country',
        name: 'India',
      },
      knowsAbout: ['Income Tax', 'GST', 'Tax Planning', 'Financial Advisory', 'FEMA'],
    },
  ],
};

const finalSchema = schemaMarkup ?? personSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!--
      Fonts:
      1. Fraunces (variable) - display/headings, opsz axis for large sizes
      2. Inter - body/UI
      3. IBM Plex Mono - numerals/data only
      Only the weights actually used are loaded.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,900&family=IBM+Plex+Mono:wght@400;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="CA Shweta Verma" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <!-- SEO extras -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="CA Shweta Verma" />
    <meta name="keywords" content="CA Shweta Verma, Chartered Accountant, Income Tax filing, GST registration, TDS compliance, tax planning India, NRI taxation, financial advisory, ICAI" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
