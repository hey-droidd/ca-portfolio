---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const {
  title = 'CA Shahid Raza Khan | International Knowledge. Local Care. | Amravati',
  description = 'CA Shahid Raza Khan, founder of Shahid Raza Khan & Co, Chartered Accountants, Amravati. EY audit experience across Europe, the Middle East & Nordics — serving Vidarbha businesses with Audit & Assurance, Regulatory Compliance and Financial Advisory.',
  ogImage = '/og-image.png',
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const siteBase = Astro.site?.href.replace(/\/$/, '') ?? 'https://cashahidraza.in';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteBase}/#person`,
      name: 'Shahid Raza Khan',
      honorificPrefix: 'CA',
      jobTitle: 'Chartered Accountant',
      description: 'Founder of Shahid Raza Khan & Co. Former EY audit professional across Europe, the Middle East and Nordic countries.',
      email: 'cashahidraza@gmail.com',
      telephone: '+917875796110',
      url: siteBase,
      sameAs: [
        'https://linkedin.com/in/shahidrazakhan',
        'https://www.instagram.com/ca_shahid_raza_khan',
      ],
      memberOf: {
        '@type': 'Organization',
        name: 'Institute of Chartered Accountants of India',
        alternateName: 'ICAI',
      },
      worksFor: { '@id': `${siteBase}/#business` },
    },
    {
      '@type': ['ProfessionalService', 'LocalBusiness'],
      '@id': `${siteBase}/#business`,
      name: 'Shahid Raza Khan & Co, Chartered Accountants',
      description: 'Audit & Assurance, Regulatory Compliance and Financial Advisory for Amravati and Vidarbha businesses. International Knowledge. Local Care.',
      url: siteBase,
      email: 'cashahidraza@gmail.com',
      telephone: '+917875796110',
      priceRange: '₹₹',
      founder: { '@id': `${siteBase}/#person` },
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Shop No 101, First Floor, Beside Indane Gas Pump, Dharam Kata, Walgaon Road',
        addressLocality: 'Amravati',
        addressRegion: 'Maharashtra',
        postalCode: '444601',
        addressCountry: 'IN',
      },
      geo: { '@type': 'GeoCoordinates', latitude: 20.9374, longitude: 77.7796 },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'],
        opens: '10:00',
        closes: '19:00',
      },
      areaServed: [
        { '@type': 'City', name: 'Amravati' },
        { '@type': 'AdministrativeArea', name: 'Vidarbha' },
        { '@type': 'Country', name: 'India' },
      ],
      serviceType: ['Audit & Assurance', 'Regulatory Compliance', 'Financial Advisory'],
      sameAs: [
        'https://linkedin.com/in/shahidrazakhan',
        'https://www.instagram.com/ca_shahid_raza_khan',
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Newsreader (display) · Public Sans (body) · Space Mono (numerals) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,500;1,6..72,600&family=Public+Sans:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Shahid Raza Khan & Co, Chartered Accountants" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <meta name="robots" content="index, follow" />
    <meta name="author" content="CA Shahid Raza Khan" />
    <meta name="keywords" content="CA Shahid Raza Khan, Chartered Accountant Amravati, EY auditor, audit assurance Vidarbha, RERA compliance, financial advisory Amravati, ICAI" />
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Amravati" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
