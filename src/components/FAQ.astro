---
const faqs = [
  {
    id: 'types',
    question: 'What types of real estate matters do you handle?',
    answer: `The practice focuses on real estate transactions, purchase and sale disputes, boundary and neighbor disputes, co-ownership disputes, landlord–tenant matters, and related real estate litigation. If your situation involves property rights, contracts, ownership, or the use of property, it is likely within scope — and a consultation can confirm that.`,
  },
  {
    id: 'when',
    question: 'When should I speak with a real estate attorney?',
    answer: `Earlier than most people do. Before signing a consequential agreement, after receiving a demand or notice, when a boundary or neighbor disagreement stops being conversational, or when co-owners reach an impasse — each of these is easier to address before positions harden. If you are unsure whether your situation is legal yet, that uncertainty itself is a good reason to ask.`,
  },
  {
    id: 'without-court',
    question: 'Can a real estate dispute be resolved without going to court?',
    answer: `Often, yes. Many property disputes are resolved through direct negotiation, structured settlement discussions, or other out-of-court paths — particularly when the facts and documents are understood early. Litigation remains an option when necessary, but it is not the starting assumption. The right path depends on the documents, the parties, and the client\u2019s objectives.`,
  },
  {
    id: 'neighbor',
    question: 'What should I do if I am involved in a property dispute with a neighbor?',
    answer: `Preserve the relevant documents — deeds, surveys, correspondence, photographs — and avoid actions that could escalate the situation or weaken your position. Do not rely on assumptions about where a boundary lies or what a prior owner agreed to. An early review of the documents usually clarifies what is actually disputed and what options exist.`,
  },
  {
    id: 'transaction-dispute',
    question: 'What should I do if a real estate transaction becomes contentious?',
    answer: `Gather the contract and all related communications, note the key dates and deadlines, and avoid further representations until the position is clear. Purchase and sale disputes frequently turn on specific contract language, disclosure, and performance — details that reward careful, early review.`,
  },
  {
    id: 'consultation',
    question: 'How does a consultation work?',
    answer: `A consultation is a conversation about the situation and your objectives: the property, the documents, the parties involved, and what outcome matters most. From there, you will have a clearer sense of the legal position and the available next steps. Use the contact options below to request one.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<section
  id="faq"
  class="faq-section section-pad"
  aria-label="Frequently asked questions"
>
  <div class="container-xl">

    <header class="faq-header">
      <div>
        <p class="label-text faq-eyebrow">FAQ · Straight answers</p>
        <h2 class="section-heading reveal">
          Answers before<br />you even ask.
        </h2>
      </div>
      <p class="faq-lede">
        General information about real estate matters and consultations.
        Nothing here is legal advice for a specific situation.
      </p>
    </header>

    <div class="faq-list" role="list" data-stagger-group>
      {faqs.map((faq) => (
        <div
          class="accordion-item"
          data-stagger-item
          id={`faq-${faq.id}`}
          role="listitem"
        >
          <button
            class="accordion-trigger"
            aria-expanded="false"
            aria-controls={`faq-body-${faq.id}`}
            id={`faq-btn-${faq.id}`}
            type="button"
          >
            <span>{faq.question}</span>
            <span class="acc-icon" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 4l4 4 4-4"/>
              </svg>
            </span>
          </button>

          <div
            class="accordion-body"
            id={`faq-body-${faq.id}`}
            role="region"
            aria-labelledby={`faq-btn-${faq.id}`}
          >
            <div class="accordion-body-inner">
              {faq.answer}
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="faq-disclaimer">
      This website provides general information only. It is not legal advice
      and does not create an attorney–client relationship.
    </p>

    <p class="faq-footer">
      Have a different question?&ensp;
      <a
        href="#contact"
        class="link-brass"
        aria-label="Contact Scott Okamoto Law with your question"
      >Ask directly →</a>
    </p>

  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-section {
    background: var(--color-canvas);
  }

  .faq-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
    margin-bottom: 56px;
  }
  .faq-eyebrow {
    color: var(--color-accent-brass-dk);
    margin: 0 0 16px;
    display: block;
  }
  .faq-header .section-heading { margin: 0; }
  .faq-lede {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-neutral-600);
    margin: 0;
    padding-bottom: 4px;
  }

  .faq-list {
    max-width: 860px;
    margin-bottom: 40px;
  }

  .faq-disclaimer {
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--color-secondary-mauve);
    max-width: 860px;
    margin: 0 0 20px;
    padding-top: 4px;
    border-top: 1px solid var(--color-hairline);
    padding-top: 20px;
  }

  .faq-footer {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-neutral-600);
    margin: 0;
  }

  @media (max-width: 768px) {
    .faq-header {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 40px;
    }
    .accordion-trigger {
      font-size: 16px;
      padding: 20px 0;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('.accordion-item');

  items.forEach(item => {
    const trigger = item.querySelector<HTMLButtonElement>('.accordion-trigger');
    const body = item.querySelector<HTMLElement>('.accordion-body');
    if (!trigger || !body) return;

    trigger.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');

      items.forEach(other => {
        const otherTrigger = other.querySelector<HTMLButtonElement>('.accordion-trigger');
        const otherBody = other.querySelector<HTMLElement>('.accordion-body');
        other.classList.remove('open');
        if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
        if (otherBody) otherBody.style.maxHeight = '';
      });

      if (!isOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
        body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });
</script>
