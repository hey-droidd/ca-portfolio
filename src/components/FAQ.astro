---
/**
 * FAQ — white background, between Recognition (indigo) and Contact (neutral-50).
 * Accordion of 6 real, commonly asked tax/GST questions.
 * Entries use the site-wide stagger system; accordion motion in global.css.
 * FAQPage JSON-LD included for SEO.
 * Placed after Recognition / before Contact.
 */

const faqs = [
  {
    id: 'tax-regime',
    question: 'Which tax regime should I choose: old or new?',
    answer: `It depends on your deductions. The new regime (default from FY 2023-24) offers lower slab rates but disallows most deductions like 80C, HRA, and home loan interest. The old regime makes sense if your total deductions exceed roughly ₹3.5–4 lakh. A quick calculation comparing your taxable income under both regimes, which I do for every client, will give you a clear answer. There is no one-size-fits-all; it varies by income level and life stage.`,
  },
  {
    id: 'notice-143',
    question: 'What happens if I receive a Section 143(1) notice?',
    answer: `Section 143(1) is an intimation, not a full scrutiny. The Income Tax Department processes your return computationally and sends this if it finds a mismatch between your filed return and its own data (TDS, advance tax, Form 26AS). Most cases involve minor arithmetic adjustments or a demand for tax. You must respond within the specified time (usually 30 days) and either accept the adjustment, dispute it, or file a rectification. Ignoring it can let a demand become final. If you receive one, share it with me immediately — most 143(1) cases are resolved quickly.`,
  },
  {
    id: 'below-exemption',
    question: 'Do I need to file a return if my income is below the basic exemption limit?',
    answer: `Not always, but often yes. Even if your income is below the basic exemption limit, you must file if: you hold foreign assets or earn foreign income, you deposited more than ₹1 crore in savings accounts, you spent over ₹2 lakh on foreign travel, or your electricity bill exceeded ₹1 lakh. Filing is also mandatory if you want to carry forward capital losses. And as a practical matter, a filed return is frequently required for visa applications, loan approvals, and government tenders.`,
  },
  {
    id: 'gst-turnover',
    question: 'When does my business need to register for GST?',
    answer: `GST registration is mandatory once your aggregate turnover in a financial year exceeds ₹40 lakh for goods or ₹20 lakh for services (₹10 lakh for special category states). Even below these limits, registration is compulsory if you sell interstate, run an e-commerce business, or fall under specific notified categories. Voluntary registration is also available if you want to claim input tax credit (ITC). Starting a new business in Vidarbha? It is worth deciding early — retrospective registration is more complicated.`,
  },
  {
    id: 'itr-deadline',
    question: 'What is the penalty for filing my ITR late?',
    answer: `Under Section 234F, a late filing fee of ₹5,000 applies if you file after the due date but before 31 December of the assessment year. This reduces to ₹1,000 if your total income is below ₹5 lakh. Beyond 31 December, you must file a belated or updated return with additional tax. Late filing also means losing the ability to carry forward most losses. The ITR due date is 31 July for most individuals — I run a filing calendar for every client so nothing slips.`,
  },
  {
    id: 'nri-taxation',
    question: 'I am an NRI with rental income in India. Do I need to file a return?',
    answer: `Yes. If your Indian-sourced income exceeds the basic exemption limit, you must file an ITR in India regardless of where you reside. Rental income from Indian property is taxable, with TDS typically deducted by the tenant. You can claim the 30% standard deduction, municipal taxes, and home loan interest, and may get relief under India's Double Taxation Avoidance Agreement (DTAA) with your country of residence. Filing also lets you claim a refund if excess TDS was deducted.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<section
  id="faq"
  class="faq-section section-pad"
  aria-label="Frequently asked questions"
>
  <div class="container-xl">

    <header class="faq-header">
      <div>
        <p class="label-text faq-eyebrow">FAQ · Straight answers</p>
        <h2 class="section-heading reveal">
          Answers before<br />you even ask.
        </h2>
      </div>
      <p class="faq-lede">
        Real questions from real clients, on tax regimes, notices, deadlines,
        and GST. If your question isn't here, just ask directly.
      </p>
    </header>

    <div class="faq-list" role="list" data-stagger-group>
      {faqs.map((faq) => (
        <div
          class="accordion-item"
          data-stagger-item
          id={`faq-${faq.id}`}
          role="listitem"
        >
          <button
            class="accordion-trigger"
            aria-expanded="false"
            aria-controls={`faq-body-${faq.id}`}
            id={`faq-btn-${faq.id}`}
            type="button"
          >
            <span>{faq.question}</span>
            <!-- Chevron icon -->
            <span class="acc-icon" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 4l4 4 4-4"/>
              </svg>
            </span>
          </button>

          <div
            class="accordion-body"
            id={`faq-body-${faq.id}`}
            role="region"
            aria-labelledby={`faq-btn-${faq.id}`}
          >
            <div class="accordion-body-inner">
              {faq.answer}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Footer nudge -->
    <p class="faq-footer">
      Have a different question?&ensp;
      <a
        href="#contact"
        class="link-brass"
        aria-label="Contact CA Shahid Raza Khan with your question"
      >Ask directly →</a>
    </p>

  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-section {
    background: var(--color-canvas);
  }

  .faq-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
    margin-bottom: 56px;
  }
  .faq-eyebrow {
    color: var(--color-accent-brass-dk);
    margin: 0 0 16px;
    display: block;
  }
  .faq-header .section-heading { margin: 0; }
  .faq-lede {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-neutral-600);
    margin: 0;
    padding-bottom: 4px;
  }

  .faq-list {
    max-width: 860px;
    margin-bottom: 40px;
  }

  /* accordion-item, accordion-trigger, accordion-body: global.css */

  .faq-footer {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-neutral-600);
    margin: 0;
  }

  @media (max-width: 768px) {
    .faq-header {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 40px;
    }
    .accordion-trigger {
      font-size: 16px;
      padding: 20px 0;
    }
  }
</style>

<script>
  /**
   * FAQ accordion — smooth height transition via max-height.
   * Opens one at a time (closes others on open).
   * Respects prefers-reduced-motion (instant via CSS).
   */
  const items = document.querySelectorAll<HTMLElement>('.accordion-item');

  items.forEach(item => {
    const trigger = item.querySelector<HTMLButtonElement>('.accordion-trigger');
    const body = item.querySelector<HTMLElement>('.accordion-body');
    if (!trigger || !body) return;

    trigger.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');

      // Close all items
      items.forEach(other => {
        const otherTrigger = other.querySelector<HTMLButtonElement>('.accordion-trigger');
        const otherBody = other.querySelector<HTMLElement>('.accordion-body');
        other.classList.remove('open');
        if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
        if (otherBody) otherBody.style.maxHeight = '';
      });

      // If it wasn't open, open it
      if (!isOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
        // Use scrollHeight for natural height
        body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });
</script>
