---
/**
 * Videos section - neutral-50 (off-white) background.
 * Horizontal-scroll gallery with real thumbnails from YouTube RSS feed.
 * Play icon fades in on hover, subtle thumbnail scale (1.0 → 1.03).
 * No API key - uses public RSS feed + img.youtube.com thumbnails.
 */
import { getRecentVideos, formatVideoDate } from '../lib/youtube';

const videos = await getRecentVideos(8);
const hasVideos = videos.length > 0;
---

<section
  id="videos"
  class="videos-section section-pad"
  aria-label="YouTube videos by CA Shweta Verma"
>
  <div class="container-xl">

    <!-- Section header -->
    <div class="videos-header">
      <div class="reveal">
        <p class="label-text videos-eyebrow">Tax explained in plain language</p>
        <h2 class="section-heading videos-title">
          Watch. Learn.<br />Decide better.
        </h2>
      </div>
      <a
        href="https://www.youtube.com/@cashwetaverma?sub_confirmation=1"
        target="_blank"
        rel="noopener noreferrer"
        class="reveal reveal-d1 btn-primary videos-subscribe"
        aria-label="Subscribe to CA Shweta Verma on YouTube"
        style="flex-shrink:0;"
      >
        <svg width="16" height="12" viewBox="0 0 18 14" fill="currentColor" aria-hidden="true">
          <path d="M17.624 2.187A2.25 2.25 0 0016.705.4C15.255 0 9 0 9 0S2.745 0 1.295.4a2.25 2.25 0 00-.92 1.787C0 3.488 0 7 0 7s0 3.512.376 4.813A2.25 2.25 0 001.295 13.6C2.745 14 9 14 9 14s6.255 0 7.705-.4a2.25 2.25 0 00.92-1.787C18 10.512 18 7 18 7s0-3.512-.376-4.813zM7.2 10V4l5.6 3-5.6 3z"/>
        </svg>
        Subscribe
      </a>
    </div>

    {hasVideos ? (
      <div class="videos-scroll-wrap" role="region" aria-label="Video gallery, scroll horizontally">
        <ol class="videos-track" role="list">
          {videos.map((video, i) => (
            <li
              class={`reveal reveal-d${Math.min(i + 1, 6)} video-card`}
              aria-label={`Video: ${video.title}`}
            >
              <div
                class="video-facade"
                data-video-id={video.id}
                role="button"
                tabindex="0"
                aria-label={`Play: ${video.title}`}
              >
                <img
                  src={video.thumbnailUrl}
                  alt={`Thumbnail: ${video.title}`}
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="270"
                />
                <!-- Play overlay - fades in on hover -->
                <div class="play-overlay" aria-hidden="true">
                  <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
                    <circle cx="28" cy="28" r="28" fill="rgba(15,44,76,0.72)"/>
                    <polygon points="22,18 42,28 22,38" fill="white"/>
                  </svg>
                </div>
              </div>

              <div class="video-meta">
                <h3 class="video-title">{video.title}</h3>
                {video.publishedAt && (
                  <time
                    datetime={video.publishedAt}
                    class="video-date"
                  >{formatVideoDate(video.publishedAt)}</time>
                )}
                <a
                  href={video.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="video-link underline-draw"
                  aria-label={`Watch ${video.title} on YouTube`}
                >
                  Watch on YouTube →
                </a>
              </div>
            </li>
          ))}
        </ol>
      </div>
    ) : (
      <div class="reveal videos-fallback">
        <p class="videos-fallback-heading">
          Weekly explainers on tax law, GST updates &amp; financial planning.
        </p>
        <p class="videos-fallback-sub">
          New videos every week. Browse the full archive on YouTube.
        </p>
        <a
          href="https://www.youtube.com/@cashwetaverma"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          aria-label="Visit CA Shweta Verma on YouTube"
          style="margin-top:24px;"
        >
          Browse all videos →
        </a>
      </div>
    )}

    <!-- Channel CTA strip -->
    <div class="reveal videos-cta-strip">
      <div>
        <p class="videos-cta-heading font-display">
          New videos every week on tax law,<br class="cta-br" /> GST updates &amp; financial planning.
        </p>
        <p class="videos-cta-sub">
          Subscribe to @cashwetaverma and never miss an important update.
        </p>
      </div>
      <a
        href="https://www.youtube.com/@cashwetaverma?sub_confirmation=1"
        target="_blank"
        rel="noopener noreferrer"
        class="videos-yt-btn"
        aria-label="Subscribe to CA Shweta Verma on YouTube"
      >
        <svg width="18" height="14" viewBox="0 0 18 14" fill="currentColor" aria-hidden="true">
          <path d="M17.624 2.187A2.25 2.25 0 0016.705.4C15.255 0 9 0 9 0S2.745 0 1.295.4a2.25 2.25 0 00-.92 1.787C0 3.488 0 7 0 7s0 3.512.376 4.813A2.25 2.25 0 001.295 13.6C2.745 14 9 14 9 14s6.255 0 7.705-.4a2.25 2.25 0 00.92-1.787C18 10.512 18 7 18 7s0-3.512-.376-4.813zM7.2 10V4l5.6 3-5.6 3z"/>
        </svg>
        Subscribe on YouTube
      </a>
    </div>

  </div>
</section>

<style>
  .videos-section {
    background-color: var(--color-neutral-50);
  }

  /* Section header */
  .videos-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 56px;
    flex-wrap: wrap;
  }
  .videos-eyebrow {
    color: var(--color-primary-blue);
    font-size: 11px;
    letter-spacing: 0.1em;
    margin: 0 0 12px;
  }
  .videos-title {
    color: var(--color-primary-ink);
    margin: 0;
  }
  .videos-subscribe {
    background-color: #FF0000;
    color: #fff;
  }
  .videos-subscribe:hover {
    background-color: #cc0000;
  }

  /* ── Horizontal scroll gallery ── */
  .videos-scroll-wrap {
    overflow-x: auto;
    overflow-y: visible;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--color-primary-blue) transparent;
    padding-bottom: 20px;
    margin-bottom: 56px;
    /* Negative margin to allow full-bleed feel while keeping padding */
    margin-left: 0px;
    margin-right: -24px;
    padding-left: 24px;
    padding-right: 24px;
  }
  .videos-scroll-wrap::-webkit-scrollbar {
    height: 4px;
  }
  .videos-scroll-wrap::-webkit-scrollbar-track {
    background: transparent;
  }
  .videos-scroll-wrap::-webkit-scrollbar-thumb {
    background: var(--color-primary-blue);
    border-radius: 2px;
    opacity: 0.4;
  }

  .videos-track {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    width: max-content;
  }

  .video-card {
    width: 320px;
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  /* Facade - from global.css .video-facade */
  .video-facade {
    margin-bottom: 16px;
    border-radius: var(--radius-lg);
  }

  .video-meta {
    padding: 0 4px;
  }
  .video-title {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-primary-ink);
    margin: 0 0 6px;
    /* Clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .video-date {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-primary-blue);
    opacity: 0.65;
    margin-bottom: 8px;
    letter-spacing: 0.04em;
  }
  .video-link {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-primary-blue);
  }

  /* Fallback */
  .videos-fallback {
    padding: 48px 0;
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
    margin-bottom: 56px;
  }
  .videos-fallback-heading {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.8vw, 32px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-primary-ink);
    margin: 0 0 12px;
    font-optical-sizing: auto;
  }
  .videos-fallback-sub {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-neutral-600);
    margin: 0;
  }

  /* CTA strip */
  .videos-cta-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    background: var(--color-primary-ink);
    border-radius: var(--radius-xl);
    padding: 40px 48px;
  }
  .videos-cta-heading {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 8px;
    line-height: 1.2;
    font-optical-sizing: auto;
  }
  .videos-cta-sub {
    font-family: var(--font-body);
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    margin: 0;
  }
  .videos-yt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FF0000;
    color: #fff;
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 150ms ease, transform 150ms ease-out;
    flex-shrink: 0;
  }
  .videos-yt-btn:hover {
    background-color: #cc0000;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .videos-header { align-items: flex-end; flex-wrap: nowrap; gap: 12px; margin-bottom: 40px; }
    .videos-header > div:first-child { min-width: 0; flex: 1 1 auto; }
    .videos-title { font-size: clamp(22px, 7vw, 28px); }
    .videos-subscribe { padding: 10px 14px; font-size: 13px; min-height: 40px; }
    .video-card { width: min(280px, calc(100vw - 64px)); }
    .videos-scroll-wrap { margin-left: 4px; margin-right: -12px; padding-left: 12px; padding-right: 12px; }
    .videos-cta-strip { padding: 32px 24px; }
    .videos-yt-btn { width: 100%; justify-content: center; }
    .cta-br { display: none; }
  }
</style>

<script>
  // Video facade: swap thumbnail for iframe on click/Enter
  document.querySelectorAll<HTMLElement>('.video-facade').forEach(facade => {
    const activate = () => {
      const videoId = facade.dataset.videoId;
      if (!videoId) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
      iframe.title = 'YouTube video player';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      facade.innerHTML = '';
      facade.appendChild(iframe);
      facade.style.cursor = 'default';
    };
    facade.addEventListener('click', activate);
    facade.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        activate();
      }
    });
  });
</script>
