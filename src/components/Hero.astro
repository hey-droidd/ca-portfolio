---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/images/profile.png';
---

<section
  id="home"
  class="hero ledger-texture"
  aria-label="Introduction: CA Shweta Verma"
>
  <div class="container-xl hero-inner">

    <!-- LEFT: Copy column -->
    <div class="hero-copy">

      <!-- Eyebrow label -->
      <p class="reveal hero-eyebrow label-text" aria-hidden="false">
        Practicing Chartered Accountant · Fellow Member, ICAI
      </p>

      <!-- Her name: Fraunces 900, hero scale - the visual anchor -->
      <h1 class="reveal reveal-d1 hero-name">
        CA&nbsp;Shweta<br />Verma
      </h1>

      <!-- Two-fragment positioning statement -->
      <!-- Fragment 1: appears with name -->
      <p class="reveal reveal-d2 hero-frag hero-frag-1">
        Clarity where tax law<br class="frag-br" /> creates confusion.
      </p>

      <!-- Visual beat: thin hairline + grid detail between fragments -->
      <div class="reveal reveal-d3 hero-divider" aria-hidden="true">
        <span class="hero-divider-line"></span>
        <span class="hero-divider-dot"></span>
        <span class="hero-divider-line"></span>
      </div>

      <!-- Fragment 2: secondary beat, slightly lower weight -->
      <p class="reveal reveal-d3 hero-frag hero-frag-2">
        Income Tax · GST · Financial Services
      </p>

      <!-- CTAs -->
      <div class="reveal reveal-d4 hero-ctas">
        <a
          href="https://wa.me/918130573445?text=Hi%20CA%20Shweta%2C%20I%20would%20like%20to%20book%20a%20consultation."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          aria-label="Book a consultation via WhatsApp"
        >
          Book a Consultation
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="#videos"
          class="btn-outline"
          aria-label="Watch CA Shweta Verma's YouTube videos"
        >
          Watch Videos
        </a>
      </div>

      <!-- Credentials row -->
      <p class="reveal reveal-d5 hero-creds">
        B.Com&ensp;·&ensp;FCA&ensp;·&ensp;DISA&ensp;·&ensp;FAFD
      </p>
    </div>

    <!-- RIGHT: Portrait column -->
    <div class="reveal reveal-d2 hero-photo-col" aria-hidden="true">
      <figure class="hero-photo">
        <div class="hero-photo-wrap">
          <Image
            src={profilePhoto}
            alt="CA Shweta Verma, Practicing Chartered Accountant"
            loading="eager"
            fetchpriority="high"
            widths={[320, 460, 720]}
            sizes="(max-width: 768px) 320px, (max-width: 1024px) 380px, 460px"
          />
        </div>
        <!-- Subtle duotone overlay in primary-ink -->
        <span class="hero-photo-overlay" aria-hidden="true"></span>
      </figure>
    </div>

  </div>
</section>

<style>
  .hero {
    background-color: #fff;
    padding-top: 148px;
    padding-bottom: 96px;
    /* Cap total height so photo never bleeds past viewport fold */
    min-height: 0;
    max-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* Ledger grid should be even subtler in the white hero */
  .hero.ledger-texture::before {
    background-image:
      linear-gradient(rgba(15,44,76,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15,44,76,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .hero-inner {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 80px;
    align-items: center;
  }

  /* ── Eyebrow ── */
  .hero-eyebrow {
    color: var(--color-primary-blue);
    margin: 0 0 20px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── Name: defined in global.css as .hero-name ── */
  h1.hero-name {
    margin: 0 0 28px;
    color: var(--color-primary-ink);
  }

  /* Copy column is the container for cqw font scaling */
  .hero-copy {
    container-type: inline-size;
  }

  /* ── Two-fragment positioning ── */
  .hero-frag {
    margin: 0;
    font-family: var(--font-body);
    line-height: 1.35;
  }

  .hero-frag-1 {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 500;
    color: var(--color-primary-ink);
    letter-spacing: -0.01em;
  }

  /* Visual beat between fragments */
  .hero-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 18px 0;
    max-width: 200px;
  }
  .hero-divider-line {
    flex: 1;
    height: 1px;
    background: var(--color-primary-blue);
    opacity: 0.4;
  }
  .hero-divider-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent-sky);
    flex-shrink: 0;
  }

  .hero-frag-2 {
    font-size: clamp(14px, 1.5vw, 17px);
    font-weight: 400;
    color: var(--color-primary-blue);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 36px;
  }

  /* ── CTAs ── */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-bottom: 36px;
  }

  /* ── Credentials ── */
  .hero-creds {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--color-primary-blue);
    opacity: 0.7;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
    max-width: 440px;
  }

  /* ── Portrait ── */
  .hero-photo-col {
    display: flex;
    justify-content: flex-end;
  }

  .hero-photo {
    margin: 0;
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 4 / 5;
    /* Never taller than viewport minus nav + section padding */
    max-height: calc(100vh - 260px);
    border-radius: 4px 64px 4px 64px; /* asymmetric - editorial feel */
    overflow: hidden;
    background: linear-gradient(135deg, #C8DBE9 0%, #8AB4CE 100%);
    box-shadow: var(--shadow-2);
  }

  .hero-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* hero-photo-wrap: brand-tint overlay container */
  .hero-photo-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-photo-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .hero-photo-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #0F2C4C 0%, transparent 60%);
    mix-blend-mode: multiply;
    opacity: 0.15;
    pointer-events: none;
  }

  /* Subtle duotone overlay - primary-ink tint at low opacity */
  .hero-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(15, 44, 76, 0.12) 0%,
      rgba(15, 44, 76, 0.04) 50%,
      transparent 100%
    );
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* ── Responsive ── */
  /* ── Tablet: side-by-side, scaled down ── */
  @media (min-width: 768px) and (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr 0.67fr;
      gap: 40px;
    }
    .hero-photo {
      max-width: 100%;
    }
  }

  /* ── Mobile: stacked, photo capped, text centered ── */
  @media (max-width: 767px) {
    .hero {
      padding-top: 112px;
      padding-bottom: 64px;
      min-height: 0;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hero-copy {
      text-align: center;
    }
    .hero-eyebrow,
    .hero-frag-1,
    .hero-frag-2,
    .hero-creds {
      text-align: center;
    }
    .hero-divider {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-ctas {
      justify-content: center;
      flex-direction: column;
      align-items: center;
    }
    .hero-creds {
      max-width: none;
      margin-left: auto;
      margin-right: auto;
    }
    /* Photo goes above copy, height-capped */
    .hero-photo-col {
      order: -1;
      justify-content: center;
    }
    .hero-photo {
      max-width: 100%;
      max-height: 55vh;
      aspect-ratio: unset;
      width: 100%;
    }
    .frag-br { display: none; }
  }

  /* ── Very small screens (≤360px) ── */
  @media (max-width: 360px) {
    .hero {
      padding-top: 96px;
      padding-bottom: 48px;
    }
    .hero-inner {
      gap: 24px;
    }
    .hero-photo {
      max-height: 45vh;
    }
    .hero-eyebrow {
      font-size: 10px;
    }
    .hero-frag-1 {
      font-size: 18px;
    }
    .hero-ctas {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
