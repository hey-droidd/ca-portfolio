---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/images/profile.jpg';
---

<section id="home" class="hero" aria-label="Scott Okamoto — Real Estate Attorney, San Francisco">
  <div class="container-xl hero-inner">

    <!-- LEFT: Copy column -->
    <div class="hero-copy">
    <p class="hero-eyebrow label-text he he-1">
      Scott Okamoto Law&ensp;·&ensp;Real Estate Attorney&ensp;·&ensp;San Francisco
    </p>

    <h1 class="hero-name he he-2">
      Scott<br />Okamoto
    </h1>

    <p class="hero-positioning he he-3">
      Practical counsel for complex real estate matters.
    </p>

    <p class="hero-sub he he-4">
      Real estate disputes become complicated quickly. Scott Okamoto helps
      property owners, buyers, sellers, landlords, tenants, and co-owners
      work through difficult property matters with careful analysis and
      clear, personal advice.
    </p>

    <nav class="hero-ctas he he-5" aria-label="Primary actions">
      <a
        href="#contact"
        class="btn-primary"
        aria-label="Schedule a consultation"
      >
        Schedule a Consultation
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a
        href="#practice-areas"
        class="btn-secondary"
        aria-label="Explore practice areas"
      >
        Explore Practice Areas
      </a>
    </nav>

    <p class="hero-creds label-text he he-6">
      Transactions&ensp;·&ensp;Ownership&ensp;·&ensp;Boundaries&ensp;·&ensp;Landlord–Tenant&ensp;·&ensp;Disputes
    </p>

    </div><!-- /.hero-copy -->

    <!-- RIGHT: Portrait column — asymmetric editorial treatment -->
    <div class="hero-photo-col he he-3">
      <figure class="hero-photo">
        <div class="hero-photo-wrap">
          <Image
            src={profilePhoto}
            alt="Scott T. Okamoto, real estate attorney in San Francisco"
            loading="eager"
            fetchpriority="high"
            widths={[320, 460, 720]}
            sizes="(max-width: 767px) 320px, (max-width: 1023px) 380px, 460px"
          />
        </div>
        <span class="hero-photo-overlay" aria-hidden="true"></span>
      </figure>
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-canvas);
    padding-top: 160px;
    padding-bottom: 96px;
    overflow: clip;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(61, 58, 92, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(61, 58, 92, 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 55%, transparent 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 80px;
    align-items: center;
  }

  .hero-eyebrow,
  .hero-creds {
    grid-column: 1 / -1;
  }

  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  .he {
    opacity: 0;
    animation: hero-enter 450ms var(--ease-out) forwards;
  }
  .he-1 { animation-delay: 60ms; }
  .he-2 { animation-delay: 130ms; }
  .he-3 { animation-delay: 200ms; }
  .he-4 { animation-delay: 270ms; }
  .he-5 { animation-delay: 340ms; }
  .he-6 { animation-delay: 410ms; }

  .hero-eyebrow {
    color: var(--color-secondary-mauve);
    margin: 0 0 28px;
    display: block;
  }

  .hero-name {
    margin: 0 0 28px;
  }

  .hero-positioning {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 500;
    font-style: italic;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-accent-brass-dk);
    margin: 0 0 24px;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-neutral-600);
    margin: 0 0 40px;
    max-width: 580px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-bottom: 48px;
  }

  .hero-creds {
    color: var(--color-secondary-mauve);
    opacity: 0.7;
    margin: 0;
    padding-top: 28px;
    border-top: 1px solid var(--color-hairline);
    display: block;
  }

  .hero-photo-col {
    display: flex;
    justify-content: flex-end;
  }

  .hero-photo {
    margin: 0;
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 4 / 5;
    max-height: calc(100vh - 260px);
    border-radius: 4px 64px 4px 64px;
    overflow: hidden;
    background:
      linear-gradient(rgba(61, 58, 92, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(61, 58, 92, 0.10) 1px, transparent 1px),
      linear-gradient(135deg, #EDE9E0 0%, #D9CFBE 55%, #C4B294 100%);
    background-size: 28px 28px, 28px 28px, cover;
    box-shadow: var(--shadow-2);
  }

  .hero-photo-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-photo-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: brightness(1.06);
  }

  .hero-photo-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #3D3A5C 0%, transparent 60%);
    mix-blend-mode: multiply;
    opacity: 0.06;
    pointer-events: none;
  }

  .hero-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(61, 58, 92, 0.05) 0%,
      rgba(61, 58, 92, 0.02) 50%,
      transparent 100%
    );
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-inner {
      grid-template-columns: 1fr 0.7fr;
      gap: 40px 28px;
      align-items: start;
    }
    .hero-copy {
      grid-column: 1;
      grid-row: 2;
    }
    .hero-photo-col {
      grid-column: 2;
      grid-row: 2;
    }
    .hero-photo {
      max-width: 100%;
      margin-top: 50px;
      margin-bottom: 32px;
    }
    .hero-eyebrow {
      grid-row: 1;
      letter-spacing: 0.06em;
    }
    .hero-creds {
      grid-row: 3;
    }
  }

  @media (max-width: 767px) {
    .hero { padding-top: 120px; padding-bottom: 64px; }
    .hero-inner { grid-template-columns: 1fr; gap: 48px; }
    .hero-photo-col { display: none; }
    .hero-sub { font-size: 16px; }
  }

  @media (max-width: 480px) {
    .hero { padding-top: 100px; }
    .hero-ctas { flex-direction: column; align-items: stretch; }
    .hero-ctas .btn-primary, .hero-ctas .btn-secondary { justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .he { opacity: 1; animation: none; }
  }
</style>
