---
/**
 * DirectAccess - primary-ink dark section.
 * Standalone differentiator: clients work with CA Shweta directly,
 * not via a junior team or call centre.
 * Large Fraunces statement + one supporting line in Inter.
 * Placed after Services, before Videos.
 */
---

<section
  id="direct-access"
  class="direct-section"
  aria-label="Why choose CA Shweta Verma: direct access"
>
  <div class="container-xl direct-inner">

    <!-- Decorative ledger lines - very faint, partial -->
    <div class="direct-grid-accent" aria-hidden="true"></div>

    <div class="direct-content">
      <p class="reveal direct-eyebrow label-text">
        What makes the difference
      </p>

      <h2 class="reveal reveal-d1 direct-statement pull-quote">
        You work with me.<br />
        Not my assistant.<br />
        Not a call centre.
      </h2>

      <p class="reveal reveal-d2 direct-body">
        Every call, every filing, every notice response. Handled personally.
        When you have a question at 9 pm before a deadline, you get a direct
        answer, not a ticket number.
      </p>

      <div class="reveal reveal-d3 direct-cta-row">
        <a
          href="https://wa.me/918130573445?text=Hi%20CA%20Shweta%2C%20I%20would%20like%20to%20book%20a%20consultation."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          aria-label="Book a direct consultation via WhatsApp"
        >
          Book a Direct Consultation
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="#contact"
          class="btn-outline-white"
          aria-label="Send an enquiry"
        >
          Send an Enquiry
        </a>
      </div>
    </div>

    <!-- Right-side decorative stat block -->
    <div class="reveal reveal-d2 direct-aside" aria-hidden="true">
      <div class="direct-stat-card">
        <span class="direct-stat-num font-mono">1:1</span>
        <span class="direct-stat-label">Always direct<br />always personal</span>
      </div>
      <div class="direct-stat-card">
        <span class="direct-stat-num font-mono">Solo</span>
        <span class="direct-stat-label">CA practice<br />no junior hand-offs</span>
      </div>
      <div class="direct-stat-card">
        <span class="direct-stat-num font-mono">12+</span>
        <span class="direct-stat-label">Years of<br />personal practice</span>
      </div>
    </div>

  </div>
</section>

<style>
  .direct-section {
    background-color: var(--color-primary-ink);
    padding-top: 96px;
    padding-bottom: 96px;
    position: relative;
    overflow: hidden;
  }

  /* Faint ledger grid accent on the right edge */
  .direct-grid-accent {
    position: absolute;
    top: 0;
    right: 0;
    width: 360px;
    height: 100%;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
    mask-image: linear-gradient(90deg, transparent 0%, black 40%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 40%);
  }

  .direct-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .direct-eyebrow {
    color: var(--color-accent-sky);
    font-size: 11px;
    letter-spacing: 0.12em;
    margin: 0 0 24px;
  }

  .direct-statement {
    color: #fff;
    margin: 0 0 28px;
    max-width: 680px;
  }

  .direct-body {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.65;
    color: rgba(255,255,255,0.65);
    margin: 0 0 40px;
    max-width: 520px;
  }

  .direct-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  /* Right aside: 3 stat cards stacked vertically */
  .direct-aside {
    display: flex;
    flex-direction: column;
    gap: 0;
    flex-shrink: 0;
    width: 180px;
  }

  .direct-stat-card {
    padding: 24px 0;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .direct-stat-card:last-child {
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .direct-stat-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 700;
    color: var(--color-accent-sky);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 6px;
  }

  .direct-stat-label {
    display: block;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    color: rgba(255,255,255,0.4);
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 960px) {
    .direct-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .direct-aside {
      flex-direction: row;
      width: 100%;
      gap: 0;
      border-top: 1px solid rgba(255,255,255,0.1);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .direct-stat-card {
      flex: 1;
      padding: 20px 0;
      border-top: none;
      border-bottom: none;
      border-right: 1px solid rgba(255,255,255,0.1);
    }
    .direct-stat-card:last-child {
      border-right: none;
      border-bottom: none;
    }
    .direct-stat-card:not(:first-child) {
      padding-left: 24px;
    }
    .direct-grid-accent { width: 200px; }
  }

  @media (max-width: 600px) {
    .direct-section { padding-top: 64px; padding-bottom: 64px; }
    .direct-statement { font-size: clamp(26px, 6vw, 36px); line-height: 1.3; }
    .direct-aside {
      flex-direction: column;
    }
    .direct-stat-card {
      border-right: none;
      border-top: 1px solid rgba(255,255,255,0.1);
      padding: 16px 0;
    }
    .direct-stat-card:not(:first-child) { padding-left: 0; }
  }
</style>
