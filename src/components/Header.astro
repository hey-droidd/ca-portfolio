---
const navLinks = [
  { href: '#about',          label: 'About' },
  { href: '#approach',       label: 'Approach' },
  { href: '#practice-areas', label: 'Practice Areas' },
  { href: '#faq',            label: 'FAQ' },
  { href: '#contact',        label: 'Contact' },
];
---

<header id="site-header" role="banner">
  <nav id="nav-bar" class="nav-bar" aria-label="Primary navigation">
    <div class="container-xl nav-inner">

      <!-- Logo left -->
      <a href="#home" class="nav-brand" aria-label="Scott Okamoto Law — go to top">
        <span class="nav-brand-badge" aria-hidden="true">SO</span>
        <span class="nav-brand-text">
          <span class="nav-brand-name">Scott Okamoto Law</span>
          <span class="nav-brand-sub">Real Estate · San Francisco</span>
        </span>
      </a>

      <!-- Links center -->
      <ul class="nav-links desktop-nav" role="list">
        {navLinks.map(({ href, label }) => (
          <li><a href={href} class="nav-link">{label}</a></li>
        ))}
      </ul>

      <!-- CTA right + hamburger -->
      <div class="nav-actions">
        <a
          href="#contact"
          class="btn-primary nav-cta"
          aria-label="Request a consultation"
        >
          Request a Consultation
        </a>
        <button
          id="menu-toggle"
          class="hamburger-btn"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
          type="button"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <rect y="3" width="20" height="2" rx="1"/>
            <rect y="9" width="20" height="2" rx="1"/>
            <rect y="15" width="20" height="2" rx="1"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" role="navigation" aria-label="Mobile navigation" class="mobile-menu">
      {navLinks.map(({ href, label }) => (
        <a href={href} class="mobile-nav-link">{label}</a>
      ))}
      <a
        href="#contact"
        class="btn-primary mobile-cta"
      >Request a Consultation</a>
    </div>
  </nav>
</header>

<style>
  .nav-bar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: box-shadow 200ms ease, border-color 200ms ease;
  }
  .nav-bar.scrolled {
    border-bottom-color: var(--color-hairline);
    box-shadow: var(--shadow-1);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
    gap: var(--space-xl);
    min-height: 68px;
  }

  .nav-brand { text-decoration: none; display: flex; align-items: center; gap: 10px; flex-shrink: 0; justify-self: start; }
  .nav-brand-badge {
    width: 36px; height: 36px;
    background: var(--color-primary-indigo);
    border-radius: var(--radius-xs);
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff;
    font-family: var(--font-display);
    font-size: 13px; font-weight: 700;
    flex-shrink: 0;
  }
  .nav-brand-text { display: flex; flex-direction: column; line-height: 1.25; }
  .nav-brand-name {
    font-family: var(--font-display);
    font-size: 15px; font-weight: 600;
    color: var(--color-primary-indigo);
    letter-spacing: -0.01em;
  }
  .nav-brand-sub {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-secondary-mauve);
    letter-spacing: 0.04em;
  }

  .nav-links { display: flex; align-items: center; justify-content: center; gap: 28px; list-style: none; margin: 0; padding: 0; justify-self: center; }
  .nav-links li { flex-shrink: 0; }
  .nav-link {
    position: relative;
    display: inline-block;
    font-size: 14px; font-weight: 500;
    line-height: 1.4;
    color: var(--color-primary-indigo);
    text-decoration: none;
    white-space: nowrap;
    opacity: 0.75;
    padding: 4px 0;
    transition: opacity 150ms ease;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 1.5px;
    background: var(--color-accent-brass);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 200ms ease;
  }
  .nav-link:hover,
  .nav-link.active { opacity: 1; }
  .nav-link:hover::after,
  .nav-link.active::after { transform: scaleX(1); }

  .nav-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-shrink: 0; justify-self: end; }
  .nav-cta { font-size: 13px; padding: 9px 18px; min-height: 38px; }

  .hamburger-btn {
    display: none; align-items: center; justify-content: center;
    background: none; border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xs); padding: 7px 9px; cursor: pointer;
    color: var(--color-primary-indigo);
  }

  .mobile-menu {
    display: none; flex-direction: column;
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
    padding: var(--space-lg) var(--space-xl) var(--space-xl);
    gap: 4px;
  }
  .mobile-menu.open { display: flex; }
  .mobile-nav-link {
    display: block; padding: 11px 0;
    font-size: 16px; font-weight: 500;
    color: var(--color-primary-indigo); text-decoration: none;
    border-bottom: 1px solid var(--color-hairline);
  }
  .mobile-nav-link.active {
    color: var(--color-accent-brass-dk);
    font-weight: 600;
  }
  .mobile-cta { margin-top: var(--space-lg); justify-content: center; }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .nav-links { gap: 20px; }
    .nav-inner { gap: var(--space-lg); }
  }
  @media (min-width: 1024px) {
    .hamburger-btn, .mobile-menu { display: none !important; }
    .desktop-nav { display: flex !important; }
  }
  @media (max-width: 1023px) {
    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .nav-brand-name { font-size: 18px; }
    .nav-brand-sub { font-size: 12px; }
    .nav-brand-badge { width: 40px; height: 40px; font-size: 14px; }
    .desktop-nav, .nav-cta { display: none !important; }
    .hamburger-btn { display: flex !important; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('open');
    mobileMenu?.classList.toggle('open', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  const navBar = document.getElementById('nav-bar');
  const hero = document.getElementById('home');
  const onScroll = () => {
    const pastHero = hero ? window.scrollY > hero.offsetHeight - 80 : window.scrollY > 60;
    navBar?.classList.toggle('scrolled', pastHero);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const spyLinks = Array.from(document.querySelectorAll('.nav-link, .mobile-nav-link'));
  const spySections = spyLinks
    .map((link) => document.querySelector(link.getAttribute('href') || ''))
    .filter((el) => !!el);

  const setActive = (id) => {
    spyLinks.forEach((link) => {
      const isActive = link.getAttribute('href') === `#${id}`;
      link.classList.toggle('active', isActive);
      if (isActive) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  };

  let skipSpy = false;
  let skipTimer;
  const lockSpy = (id) => {
    setActive(id);
    skipSpy = true;
    clearTimeout(skipTimer);
    skipTimer = setTimeout(() => { skipSpy = false; }, 1200);
  };
  if ('scrollend' in window) {
    window.addEventListener('scrollend', () => {
      skipSpy = false;
      clearTimeout(skipTimer);
    });
  }

  if ('IntersectionObserver' in window && spySections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        if (skipSpy) return;
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
    );
    spySections.forEach((section) => spy.observe(section));
  }

  spyLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href') || '';
      if (href.startsWith('#')) lockSpy(href.slice(1));
    });
  });
</script>
