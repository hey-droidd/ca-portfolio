---
/**
 * CONTACT — neutral-50 background.
 * Two-column layout: channels left, office address right.
 * No form. WhatsApp-first.
 * Stripe: card-feature-light structure for the address block.
 */
const mapQuery = encodeURIComponent('Shahid Raza Khan Co Chartered Accountants Walgaon Road Amravati');
---

<section id="contact" class="contact-section section-pad" aria-label="Contact CA Shahid Raza Khan">
  <div class="container-xl">

    <header class="contact-header">
      <p class="label-text contact-eyebrow">Contact · Visit · Call · Message</p>
      <h2 class="section-heading reveal">
        Reach us directly.
      </h2>
      <p class="contact-sub">
        Every enquiry is handled personally. No call centres, no junior
        handoffs. A real office in Amravati for clients who prefer to walk in.
      </p>
    </header>

    <div class="contact-grid">

      <!-- Left: channels -->
      <div class="contact-channels-col">
        <p class="label-text contact-col-heading">Direct Lines</p>

        <a
          href="https://wa.me/918087128040?text=Hi%20CA%20Shahid%2C%20I%20have%20an%20enquiry."
          target="_blank"
          rel="noopener noreferrer"
          class="contact-row"
          aria-label="Chat on WhatsApp: +91 80871 28040"
        >
          <span class="contact-row-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          </span>
          <span class="contact-row-text">
            <span class="contact-row-label label-text">
              WhatsApp
              <span class="contact-fastest">fastest</span>
            </span>
            <span class="contact-row-value">+91 80871 28040</span>
          </span>
        </a>

        <a
          href="tel:+917875796110"
          class="contact-row"
          aria-label="Call +91 78757 96110"
        >
          <span class="contact-row-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.13.96.36 1.9.7 2.8a2 2 0 01-.45 2.1L8.1 9.9a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0122 16.9z"/></svg>
          </span>
          <span class="contact-row-text">
            <span class="contact-row-label label-text">Phone</span>
            <span class="contact-row-value">+91 78757 96110</span>
          </span>
        </a>

        <a
          href="mailto:cashahidraza@gmail.com"
          class="contact-row"
          aria-label="Email cashahidraza@gmail.com"
        >
          <span class="contact-row-icon" aria-hidden="true">
            <svg width="18" height="14" viewBox="0 0 22 17" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="0.75" y="0.75" width="20.5" height="15.5" rx="2"/><path d="M1 2l10 8 10-8" stroke-linecap="round"/></svg>
          </span>
          <span class="contact-row-text">
            <span class="contact-row-label label-text">Email</span>
            <span class="contact-row-value contact-email">cashahidraza@gmail.com</span>
          </span>
        </a>

      </div>

    <!-- Right: office address -->
      <div class="contact-office-col">
        <p class="label-text contact-col-heading">Visit the Office</p>

        <!-- Stripe card-feature-light structure for address block -->
        <address class="contact-address card" style="font-style:normal;">
          <p class="contact-address-label label-text">Office Address</p>
          <p class="contact-address-lines">
            Shop No 101, First Floor,<br />
            Beside Indane Gas Pump, Dharam Kata,<br />
            Walgaon Road, Amravati 444601 (M.S.)
          </p>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
            target="_blank"
            rel="noopener noreferrer"
            class="link-brass contact-directions"
            aria-label="Get directions on Google Maps"
          >
            Get directions →
          </a>
        </address>

        <!-- Map embed -->
        <div class="contact-map card-sm">
          <iframe
            title="Map: Shahid Raza Khan & Co, Walgaon Road, Amravati"
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>

        <p class="contact-hours label-text">
          Mon – Sat&ensp;·&ensp;10:00 – 19:00
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  .contact-section { background: var(--color-neutral-50); }

  /* Header */
  .contact-header { margin-bottom: 56px; }
  .contact-eyebrow { color: var(--color-accent-brass-dk); margin: 0 0 16px; display: block; }
  .contact-header .section-heading { margin: 0 0 16px; }
  .contact-sub {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-neutral-600);
    max-width: 520px;
    margin: 0;
  }

  /* Two-column grid */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  /* Column headings */
  .contact-col-heading {
    color: var(--color-secondary-mauve);
    margin: 0 0 20px;
    display: block;
  }

  /* Channel rows */
  .contact-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--color-hairline);
    text-decoration: none;
    transition: opacity 150ms ease;
  }
  .contact-row:last-of-type { border-bottom: 1px solid var(--color-hairline); }
  .contact-row:hover { opacity: 0.72; }

  .contact-row-icon { color: var(--color-accent-brass); display: flex; flex-shrink: 0; }
  .contact-row-text { display: flex; flex-direction: column; gap: 3px; }
  /* Label treatment from .label-text (single site-wide label scale) */
  .contact-row-label {
    color: var(--color-secondary-mauve);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .contact-fastest {
    background: rgba(176, 141, 87, 0.14);
    color: var(--color-accent-brass-dk);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .contact-row-value {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--color-primary-indigo);
    overflow-wrap: anywhere;
  }
  .contact-email { font-size: var(--text-body); word-break: break-all; }

  /* Office card */
  .contact-address {
    margin: 0 0 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact-address-label {
    color: var(--color-accent-brass-dk);
    margin: 0 0 8px;
    display: block;
  }
  .contact-address-lines {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-primary-indigo);
    margin: 0 0 12px;
  }
  .contact-directions { font-size: 14px; font-weight: 500; }

  /* Map */
  .contact-map {
    padding: 8px;
    margin: 0 0 12px;
  }
  .contact-map iframe {
    width: 100%;
    height: 280px;
    border: 0;
    display: block;
    border-radius: var(--radius-md);
    filter: grayscale(20%) contrast(1.02);
  }

  .contact-hours {
    color: var(--color-secondary-mauve);
    display: block;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
  }
  @media (max-width: 600px) {
    .contact-map iframe { height: 240px; }
  }
</style>
