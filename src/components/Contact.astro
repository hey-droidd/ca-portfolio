---
const mapQuery = encodeURIComponent('1832 Buchanan Street Suite 202 San Francisco CA 94115');
---

<section id="contact" class="contact-section section-pad" aria-label="Contact Scott Okamoto Law">
  <div class="container-xl">

    <header class="contact-header">
      <p class="label-text contact-eyebrow">Consultation · San Francisco</p>
      <h2 class="section-heading reveal">
        Let’s discuss the matter.
      </h2>
      <p class="contact-sub">
        If you are dealing with a real estate transaction, ownership issue,
        or property dispute, start with a conversation about the situation
        and your objectives.
      </p>
    </header>

    <div class="contact-grid">

      <!-- Left: channels -->
      <div class="contact-channels-col">
        <p class="label-text contact-col-heading">Request a Consultation</p>

        <a
          href="#contact"
          class="contact-row contact-row--primary"
          aria-label="Request a consultation"
        >
          <span class="contact-row-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          </span>
          <span class="contact-row-text">
            <span class="contact-row-label label-text">
              Consultation
              <span class="contact-fastest">Start here</span>
            </span>
            <span class="contact-row-value">Request a Consultation</span>
          </span>
        </a>

        <a
          href="tel:+14157665871"
          class="contact-row"
          aria-label="Call the office at 415-766-5871"
        >
          <span class="contact-row-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.13.96.36 1.9.7 2.8a2 2 0 01-.45 2.1L8.1 9.9a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0122 16.9z"/></svg>
          </span>
          <span class="contact-row-text">
            <span class="contact-row-label label-text">Call the Office</span>
            <span class="contact-row-value">415-766-5871</span>
          </span>
        </a>

        <a
          href="mailto:scott@scottokamotolaw.com"
          class="contact-row"
          aria-label="Email scott@scottokamotolaw.com"
        >
          <span class="contact-row-icon" aria-hidden="true">
            <svg width="18" height="14" viewBox="0 0 22 17" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="0.75" y="0.75" width="20.5" height="15.5" rx="2"/><path d="M1 2l10 8 10-8" stroke-linecap="round"/></svg>
          </span>
          <span class="contact-row-text">
            <span class="contact-row-label label-text">Email</span>
            <span class="contact-row-value contact-email">scott@scottokamotolaw.com</span>
          </span>
        </a>

        <p class="contact-row contact-row--static" aria-label="Fax 415-931-2216">
          <span class="contact-row-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="7"/></svg>
          </span>
          <span class="contact-row-text">
            <span class="contact-row-label label-text">Fax</span>
            <span class="contact-row-value">415-931-2216</span>
          </span>
        </p>

      </div>

      <!-- Right: office -->
      <div class="contact-office-col">
        <p class="label-text contact-col-heading">Office</p>

        <address class="contact-address card" style="font-style:normal;">
          <p class="contact-address-label label-text">Location</p>
          <p class="contact-address-lines">
            1832 Buchanan Street, Suite 202,<br />
            San Francisco, CA 94115
          </p>
          <p class="contact-address-sub">
            Real estate matters handled with personal attorney involvement.
            Consultations by arrangement.
          </p>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
            target="_blank"
            rel="noopener noreferrer"
            class="link-brass contact-directions"
            aria-label="Get directions on Google Maps"
          >
            Get directions →
          </a>
        </address>

        <div class="contact-map card-sm">
          <iframe
            title="Map: Law Office of Scott T. Okamoto, 1832 Buchanan Street, San Francisco"
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>

        <p class="contact-hours label-text">
          Consultation&ensp;·&ensp;By arrangement
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  .contact-section { background: var(--color-neutral-50); }

  .contact-header { margin-bottom: 56px; }
  .contact-eyebrow { color: var(--color-accent-brass-dk); margin: 0 0 16px; display: block; }
  .contact-header .section-heading { margin: 0 0 16px; }
  .contact-sub {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-neutral-600);
    max-width: 520px;
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .contact-col-heading {
    color: var(--color-secondary-mauve);
    margin: 0 0 20px;
    display: block;
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--color-hairline);
    text-decoration: none;
    transition: opacity 150ms ease;
  }
  .contact-row:last-of-type { border-bottom: 1px solid var(--color-hairline); }
  .contact-row:hover { opacity: 0.72; }
  .contact-row--static:hover { opacity: 1; }

  .contact-row-icon { color: var(--color-accent-brass); display: flex; flex-shrink: 0; }
  .contact-row-text { display: flex; flex-direction: column; gap: 3px; }
  .contact-row-label {
    color: var(--color-secondary-mauve);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .contact-fastest {
    background: rgba(176, 141, 87, 0.14);
    color: var(--color-accent-brass-dk);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .contact-row-value {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--color-primary-indigo);
    overflow-wrap: anywhere;
  }
  .contact-email { font-size: var(--text-body); word-break: break-all; }

  .contact-note {
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--color-secondary-mauve);
    margin: 16px 0 0;
    max-width: 44ch;
  }

  .contact-address {
    margin: 0 0 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact-address-label {
    color: var(--color-accent-brass-dk);
    margin: 0 0 8px;
    display: block;
  }
  .contact-address-lines {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-primary-indigo);
    margin: 0 0 12px;
  }
  .contact-address-sub {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-neutral-600);
    margin: 0 0 12px;
  }

  .contact-directions { font-size: 14px; font-weight: 500; }

  .contact-map {
    padding: 8px;
    margin: 0 0 12px;
  }
  .contact-map iframe {
    width: 100%;
    height: 280px;
    border: 0;
    display: block;
    border-radius: var(--radius-md);
    filter: grayscale(20%) contrast(1.02);
  }

  .contact-hours {
    color: var(--color-secondary-mauve);
    display: block;
  }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
  }
  @media (max-width: 600px) {
    .contact-map iframe { height: 240px; }
  }
</style>
