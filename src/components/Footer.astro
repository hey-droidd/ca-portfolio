---
const year = new Date().getFullYear();

const navCols = [
  {
    heading: 'Practice Areas',
    links: [
      { label: 'Transactions', href: '#practice-areas' },
      { label: 'Real Estate Disputes', href: '#practice-areas' },
      { label: 'Boundary & Neighbor', href: '#practice-areas' },
      { label: 'Co-Ownership', href: '#practice-areas' },
      { label: 'Landlord–Tenant', href: '#practice-areas' },
    ],
  },
  {
    heading: 'Firm',
    links: [
      { label: 'About', href: '#about' },
      { label: 'Approach', href: '#approach' },
      { label: 'Who Scott Represents', href: '#represented' },
      { label: 'FAQ', href: '#faq' },
      { label: 'Contact', href: '#contact' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Privacy', href: '#footer' },
      { label: 'Legal Disclaimer', href: '#faq' },
    ],
  },
];
---

<footer id="footer" role="contentinfo" class="footer">
  <div class="container-xl footer-body">

    <div class="footer-top">

      <!-- Brand col -->
      <div class="footer-brand-col">
        <a href="#home" class="footer-brand" aria-label="Scott Okamoto Law — go to top">
          <span class="footer-badge" aria-hidden="true">SO</span>
          <span class="footer-brand-name">Scott Okamoto Law</span>
        </a>
        <p class="footer-tagline">
          Real Estate Law · San Francisco.
        </p>
        <p class="footer-address">
          Law Office of Scott T. Okamoto<br />
          1832 Buchanan Street, Suite 202,<br />
          San Francisco, CA 94115<br />
          <a href="tel:+14157665871" class="footer-link footer-mono">415-766-5871</a><br />
          <a href="mailto:scott@scottokamotolaw.com" class="footer-link footer-mono">scott@scottokamotolaw.com</a>
        </p>
      </div>

      <!-- Nav cols -->
      {navCols.map(col => (
        <div class="footer-nav-col">
          <h3 class="footer-col-heading label-text">{col.heading}</h3>
          <ul role="list" class="footer-link-list">
            {col.links.map(link => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

    </div>

    <div class="footer-bottom">
      <p class="footer-legal">© {year} Scott Okamoto Law. All rights reserved.</p>
      <p class="footer-legal footer-disclaimer">Informational website — not legal advice. No attorney–client relationship is created by using this site.</p>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-primary-indigo); }

  .footer-body { padding-top: var(--space-huge); }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-xxl);
    padding-bottom: var(--space-xxl);
    border-bottom: 1px solid rgba(255,255,255,0.10);
  }

  .footer-brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; margin-bottom: 14px; }
  .footer-badge {
    width: 32px; height: 32px;
    background: var(--color-accent-brass-dk);
    border-radius: var(--radius-xs);
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; font-family: var(--font-display); font-size: 12px; font-weight: 700;
    flex-shrink: 0;
  }
  .footer-brand-name {
    font-family: var(--font-display);
    font-size: 15px; font-weight: 600; color: #fff;
  }
  .footer-tagline {
    font-family: var(--font-display); font-style: italic; font-size: 13px;
    color: var(--color-accent-brass-lt); margin: 0 0 12px; line-height: 1.55;
  }
  .footer-address { font-size: var(--text-caption); line-height: 1.6; color: var(--color-on-dark-faint); margin: 0 0 18px; }

  .footer-col-heading { color: var(--color-on-dark-faint); margin: 0 0 14px; }
  .footer-link-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .footer-link { font-size: 13px; color: var(--color-on-dark-muted); text-decoration: none; transition: color 150ms ease; }
  .footer-link:hover { color: var(--color-accent-brass-lt); }

  .footer-bottom {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 12px; flex-wrap: wrap;
    padding: 20px 0;
  }
  .footer-legal { font-size: var(--text-caption); color: var(--color-on-dark-faint); margin: 0; }
  .footer-disclaimer { max-width: 52ch; }

  @media (max-width: 900px) {
    .footer-top { grid-template-columns: 1fr 1fr; }
    .footer-brand-col { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .footer-top { grid-template-columns: 1fr 1fr; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
