---
// Educational disclaimer - mirrors @cashwetaverma YouTube channel disclaimer
---

<section
  id="disclaimer"
  aria-label="Educational disclaimer"
  style="background: var(--color-canvas-cream);"
>
  <div class="container-xl" style="padding-top: 56px; padding-bottom: 56px;">
    <div
      style="
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 28px;
        align-items: start;
        max-width: 860px;
      "
      class="disclaimer-grid"
    >
      <!-- Icon -->
      <div
        aria-hidden="true"
        style="
          width: 44px; height: 44px;
          border-radius: var(--radius-md);
          background: var(--color-lemon);
          display: flex; align-items: center; justify-content: center;
          flex-shrink: 0;
          opacity: 0.75;
        "
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="9" stroke="#fff" stroke-width="1.5"/>
          <path d="M10 6v5" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="10" cy="14" r="0.75" fill="#fff"/>
        </svg>
      </div>

      <!-- Text -->
      <div>
        <h2
          class="heading-md"
          style="color: var(--color-ink); margin: 0 0 10px; font-weight: 400;"
        >Educational Content Disclaimer</h2>
        <p
          class="body-md"
          style="color: var(--color-ink-secondary); margin: 0; line-height: 1.65; max-width: 720px;"
        >
          All content published on this website and the YouTube channel <strong style="font-weight: 400;">@cashwetaverma</strong> is for general educational and informational purposes only. It does not constitute personalised tax, legal, or financial advice, and should not be relied upon as such.
          Tax laws, GST regulations, and compliance requirements are subject to frequent amendments. Please verify current rules with an authorised professional or the relevant government authority before acting on any information.
          Viewing or accessing this content does not create a client–advisor relationship. For advice specific to your circumstances, please <a href="#contact" class="link" style="color: var(--color-primary);">book a direct consultation</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 600px) {
    .disclaimer-grid { grid-template-columns: 1fr !important; }
  }
</style>
