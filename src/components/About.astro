---
const steps = [
  {
    no: '01',
    title: 'Understand the property',
    text: 'Review the transaction, ownership structure, agreements, and competing interests before recommending a course of action.',
  },
  {
    no: '02',
    title: 'Define the problem',
    text: 'Separate the legal issue from the surrounding noise and identify the decisions that actually matter.',
  },
  {
    no: '03',
    title: 'Build the strategy',
    text: 'Evaluate negotiation, settlement, litigation, or other available paths against the client\u2019s objectives.',
  },
  {
    no: '04',
    title: 'Move deliberately',
    text: 'Give clients clear next steps rather than unnecessary legal complexity — and stay personally involved.',
  },
];
---

<section id="about" class="about-section section-pad" aria-label="About Scott Okamoto Law">
  <div class="container-xl">

    <div class="about-body">

      <div class="about-copy">
        <h2 class="section-heading on-dark reveal">
          Clear advice when<br />the property stakes are high.
        </h2>

        <p class="about-para">
          Scott Okamoto counsels clients navigating real estate transactions,
          ownership questions, and property disputes in San Francisco. Each
          matter starts with careful analysis of the documents, the property,
          and the business context behind them.
        </p>
        <p class="about-para">
          Where negotiation can resolve the issue, he pursues it. Where
          litigation is necessary, he prepares for it. Either way, clients
          work directly with their attorney — and leave each conversation
          knowing what comes next.
        </p>

        <dl class="about-creds" aria-label="How the firm works">
          <div class="about-cred">
            <dt>Analysis</dt>
            <dd>Facts, documents, and property context first</dd>
          </div>
          <div class="about-cred">
            <dt>Advice</dt>
            <dd>Plain-language options, risks, and trade-offs</dd>
          </div>
          <div class="about-cred">
            <dt>Resolution</dt>
            <dd>Negotiation where possible, litigation when needed</dd>
          </div>
          <div class="about-cred">
            <dt>Access</dt>
            <dd>Personal attorney involvement throughout</dd>
          </div>
        </dl>
      </div>

      <aside class="about-steps" aria-label="The firm’s approach">
        <p class="label-text about-stats-eyebrow">Approach · Four moves, in order</p>
        <ol class="about-stats-list" data-stagger-group>
          {steps.map(s => (
            <li class="about-stat-block" data-stagger-item>
              <span class="about-step-no" aria-hidden="true">{s.no}</span>
              <h3 class="about-step-title">{s.title}</h3>
              <p class="about-step-text">{s.text}</p>
            </li>
          ))}
        </ol>
      </aside>

    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    background: var(--color-primary-indigo);
    overflow: clip;
  }

  .about-section::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  .about-body {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 80px;
    align-items: start;
  }

  .about-copy .section-heading { margin: 0 0 28px; }

  .about-para {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-on-dark-muted);
    margin: 0 0 18px;
  }

  .about-creds {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 36px 0 0;
    border-top: 1px solid rgba(255,255,255,0.12);
  }
  .about-cred {
    padding: 16px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .about-cred:nth-child(odd) {
    padding-right: 24px;
    border-right: 1px solid rgba(255,255,255,0.08);
  }
  .about-cred:nth-child(even) { padding-left: 24px; }
  .about-cred dt {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-brass-lt);
    margin-bottom: 4px;
  }
  .about-cred dd {
    font-size: var(--text-caption);
    color: var(--color-on-dark-muted);
    margin: 0;
    line-height: 1.6;
  }

  .about-steps { padding-top: 8px; }
  .about-stats-eyebrow {
    color: var(--color-on-dark-faint);
    margin: 0 0 32px;
    display: block;
  }
  .about-stats-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255,255,255,0.12);
  }
  .about-stat-block {
    padding: 28px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .about-step-no {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--color-accent-brass-lt);
    margin-bottom: 8px;
  }
  .about-step-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-on-dark);
    margin: 0 0 8px;
  }
  .about-step-text {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-on-dark-muted);
    margin: 0;
  }
  @media (max-width: 900px) {
    .about-body { grid-template-columns: 1fr; gap: 52px; }
  }
  @media (max-width: 600px) {
    .about-cred:nth-child(odd) { padding-right: 12px; }
    .about-cred:nth-child(even) { padding-left: 12px; }
  }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        revealObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  const staggerObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const items = entry.target.querySelectorAll('[data-stagger-item]');
      items.forEach((item, i) => {
        const el = item as HTMLElement;
        if (!prefersReduced) el.style.transitionDelay = `${i * 55}ms`;
        el.classList.add('visible');
        el.addEventListener('transitionend', () => { el.style.transitionDelay = ''; }, { once: true });
      });
      staggerObs.unobserve(entry.target);
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));
  document.querySelectorAll('[data-stagger-group]').forEach(el => staggerObs.observe(el));
</script>
