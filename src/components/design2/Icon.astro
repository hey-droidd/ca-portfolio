---
/**
 * Single-stroke icon family (1.7px, round caps). One visual voice
 * across the page — no mixed libraries, no emoji.
 */
interface Props {
  name:
    | 'check'
    | 'arrow'
    | 'plus'
    | 'calc'
    | 'shield'
    | 'phone'
    | 'mail'
    | 'pin'
    | 'quote'
    | 'spark'
    | 'clock'
    | 'doc'
    | 'factory'
    | 'store'
    | 'briefcase'
    | 'rocket';
  size?: number;
}

const { name, size = 16 } = Astro.props;

const paths: Record<string, string> = {
  check: '<path d="M2.5 8.5 6.5 12.5 13.5 3.5"/>',
  arrow: '<path d="M2.5 8h10M9.5 4 13.5 8l-4 4"/>',
  plus: '<path d="M8 3v10M3 8h10"/>',
  calc: '<rect x="3.5" y="2.5" width="9" height="11" rx="1.5"/><path d="M6 5.5h4M6 8.5h.5M8 8.5h.5M10 8.5h.5M6 11h.5M8 11h.5M10 11h.5"/>',
  shield: '<path d="M8 2 3.5 4v4c0 3.2 2 5.4 4.5 6 2.5-.6 4.5-2.8 4.5-6V4L8 2Z"/><path d="M6 7.8l1.5 1.5 2.6-2.8"/>',
  phone: '<path d="M5 3h2.5L9 5.8 7.4 7c.7 1.5 1.8 2.6 3.3 3.3l1.2-1.6L14.5 10v2.5c0 .3-.2.5-.5.5C7.7 13 3.5 8.8 3.5 3.5c0-.3.7-.5 1.5-.5Z"/>',
  mail: '<rect x="2.5" y="4" width="11" height="8" rx="1.5"/><path d="m3.5 5.5 4.5 3.5 4.5-3.5"/>',
  pin: '<path d="M8 14s4.5-4.2 4.5-7.5A4.5 4.5 0 0 0 8 2 4.5 4.5 0 0 0 3.5 6.5C3.5 9.8 8 14 8 14Z"/><circle cx="8" cy="6.5" r="1.6"/>',
  quote: '<path d="M3.5 10.5c0-3 1.8-5 4.5-5.8l.4 1c-1.7.7-2.7 1.9-2.9 3.3.2-.1.7-.2 1-.2 1 0 1.7.7 1.7 1.7 0 1-.8 1.7-1.8 1.7-1.2 0-2.9-.6-2.9-1.7Z"/><path d="M9.5 10.5c0-3 1.8-5 4.5-5.8l.4 1c-1.7.7-2.7 1.9-2.9 3.3.2-.1.7-.2 1-.2 1 0 1.7.7 1.7 1.7 0 1-.8 1.7-1.8 1.7-1.2 0-2.9-.6-2.9-1.7Z"/>',
  spark: '<path d="M8 2.5 9.6 6.4 13.5 8 9.6 9.6 8 13.5 6.4 9.6 2.5 8l3.9-1.6L8 2.5Z"/>',
  clock: '<circle cx="8" cy="8" r="5.5"/><path d="M8 5v3.2l2.2 1.3"/>',
  doc: '<path d="M4.5 2.5h5L12 5v8.5H4.5V2.5Z"/><path d="M9.3 2.7V5H12M6.5 8h4M6.5 10.5h4"/>',
  factory: '<path d="M2.5 13.5V8l3.5-2v2.2L9.5 6v2.2l4-2.4v7.7h-11Z"/><path d="M6.5 13.5v-2.5h3v2.5"/>',
  store: '<path d="M2.5 4h2l1.6 6.5h6.6L14.5 6H5.2"/><circle cx="6.8" cy="13" r="1"/><circle cx="11.6" cy="13" r="1"/>',
  briefcase: '<rect x="2.5" y="5.5" width="11" height="8" rx="1.5"/><path d="M6 5.5V4.2A1.2 1.2 0 0 1 7.2 3h1.6A1.2 1.2 0 0 1 10 4.2v1.3M2.5 8.5h11"/>',
  rocket: '<path d="M8 2.5c2 1.5 2.8 4 2.5 6.5L8 11.5C5.5 11.2 4.5 8.7 5 6c.5-1.5 1.5-2.7 3-3.5Z"/><circle cx="8" cy="7.5" r="1.2"/><path d="M5.7 11.3 4.2 14M10.3 11.3l1.5 2.7"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
