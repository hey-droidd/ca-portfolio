---
/** Approach: four sequential steps. Numbering justified: it is a process. */
import type { WebsiteConfig } from '../../lib/design2/types';

interface Props {
  approach: WebsiteConfig['content']['approach'];
}

const { approach } = Astro.props;
---

<section class="section-pad" id="approach" aria-label="Working process" data-mask-root>
  <div class="wrap">
    <h2 class="sec-title"><span class="mask"><span>{approach.heading}</span></span></h2>
    <p class="lede">{approach.lede}</p>
    <ol class="steps">
      {approach.steps.map((s) => (
        <li>
          <p class="num" aria-hidden="true">{s.index}</p>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .sec-title { margin: 0; max-width: 22ch; }
  .lede { margin-top: 16px; }
  .steps { list-style: none; margin: 60px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; }
  .steps li { border-top: 2px solid var(--color-ink); padding-top: 22px; }
  .num { margin: 0; font-family: var(--font-display); font-size: 15px; font-weight: 700; color: var(--color-bronze-deep); letter-spacing: 0.06em; }
  .steps h3 { margin: 12px 0 0; font-family: var(--font-display); font-size: 19px; font-weight: 700; color: var(--color-ink); }
  .steps p:last-child { margin: 10px 0 0; font-size: 14.5px; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr 1fr; gap: 32px; } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
