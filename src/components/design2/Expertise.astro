---
/**
 * Expertise as an interactive index: full-width rows, hover reveals the
 * detail layer. No cards. Whole row is one link to #contact.
 */
import type { WebsiteConfig } from '../../lib/design2/types';

interface Props {
  expertise: WebsiteConfig['content']['expertise'];
  contactHref: string;
}

const { expertise, contactHref } = Astro.props;
---

<section class="section-pad expertise" id="expertise" aria-label="Areas of expertise" data-mask-root>
  <div class="wrap">
    <p class="kicker">{expertise.kicker}</p>
    <h2 class="sec-title"><span class="mask"><span>{expertise.heading}</span></span></h2>
    <p class="lede">{expertise.lede}</p>
    <ol class="index">
      {expertise.services.map((s) => (
        <li>
          <a class="row" href={contactHref} aria-label={`${s.title}. ${s.body} Start a conversation.`}>
            <span class="idx" aria-hidden="true">{s.index}</span>
            <span class="main">
              <span class="row-title">{s.title}</span>
              <span class="detail">{s.body}</span>
              <span class="tags">
                {s.points.map((p) => (
                  <span class="chip">{p}</span>
                ))}
              </span>
            </span>
            <span class="go" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 9h11M10 4.5 14.5 9 10 13.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .expertise .sec-title { margin: 0; max-width: 16ch; }
  .expertise .lede { margin-top: 16px; }
  .index { list-style: none; margin: 56px 0 0; padding: 0; border-top: 1px solid var(--color-ink); }
  .index li { border-bottom: 1px solid var(--color-line); }
  .row {
    display: grid; grid-template-columns: 88px 1fr 56px; gap: 24px; align-items: start;
    padding: 30px 12px; text-decoration: none; position: relative;
    transition: background 200ms ease;
  }
  .row::before {
    content: ""; position: absolute; inset: 0; background: var(--color-canvas);
    opacity: 0; transition: opacity 200ms ease; pointer-events: none;
  }
  .row:hover::before { opacity: 1; }
  .row > * { position: relative; }
  .idx { font-family: var(--font-display); font-size: 14px; font-weight: 600; color: var(--color-bronze-deep); padding-top: 6px; }
  .row-title { display: block; font-family: var(--font-display); font-size: clamp(22px, 2.6vw, 30px); font-weight: 600; letter-spacing: -0.015em; color: var(--color-ink); transition: transform 260ms var(--ease-lux); }
  .row:hover .row-title { transform: translateX(10px); }
  .detail { display: block; margin-top: 10px; font-size: 15px; color: var(--color-graphite); max-width: 68ch; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .chip {
    font-size: 12.5px; font-weight: 600; color: var(--color-graphite);
    border: 1px solid var(--color-line); border-radius: 999px; padding: 5px 13px; background: transparent;
  }
  .go {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid var(--color-line); color: var(--color-ink);
    transition: background 220ms ease, color 220ms ease, border-color 220ms ease, transform 260ms var(--ease-lux);
  }
  .row:hover .go { background: var(--color-ink); border-color: var(--color-ink); color: #fcfaf7; transform: translateX(6px); }
  @media (max-width: 767px) { .row { grid-template-columns: 48px 1fr; gap: 14px; } .go { display: none; } }
</style>
