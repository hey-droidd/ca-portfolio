---
/** Industries: open two-column composition, dividers only, no boxes. */
import Icon from './Icon.astro';
import type { WebsiteConfig } from '../../lib/design2/types';

interface Props {
  industries: WebsiteConfig['content']['industries'];
}

const { industries } = Astro.props;
---

<section class="section-pad" id="industries" aria-label="Sectors served" data-mask-root>
  <div class="wrap">
    <h2 class="sec-title"><span class="mask"><span>{industries.heading}</span></span></h2>
    <p class="lede">{industries.lede}</p>
    <div class="groups">
      {industries.groups.map((g) => (
        <article>
          <span class="g-icon" aria-hidden="true"><Icon name={g.icon} size={19} /></span>
          <h3>{g.title}</h3>
          <p>{g.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .sec-title { margin: 0; max-width: 20ch; }
  .lede { margin-top: 16px; }
  .groups { display: grid; grid-template-columns: 1fr 1fr; gap: 0 64px; margin-top: 52px; }
  .groups article { padding: 28px 0; border-top: 1px solid var(--color-line); }
  .g-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%; margin-bottom: 16px;
    border: 1px solid rgba(113, 63, 70, 0.35); color: var(--color-bronze-deep);
    background: var(--color-canvas);
  }
  .groups article:nth-last-child(-n+2) { border-bottom: 1px solid var(--color-line); }
  .groups h3 { margin: 0; font-family: var(--font-display); font-size: 21px; font-weight: 700; color: var(--color-ink); }
  .groups p { margin: 10px 0 0; font-size: 15px; max-width: 46ch; }
  @media (max-width: 767px) {
    .groups { grid-template-columns: 1fr; }
    .groups article:nth-last-child(-n+2) { border-bottom: none; }
    .groups article:last-child { border-bottom: 1px solid var(--color-line); }
  }
</style>
