---
import type { WebsiteConfig } from '../../lib/design2/types';

interface Props {
  footer: WebsiteConfig['content']['footer'];
  business: WebsiteConfig['business'];
}

const { footer, business } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer" aria-label="Footer">
  <div class="wrap">
    <div class="top">
      <div>
        <p class="wordmark">{business.name}</p>
        <p class="tagline">{footer.tagline}</p>
      </div>
      <a class="btn btn-ghost" href={business.contactHref}>Start a conversation</a>
    </div>
    <div class="cols">
      {footer.columns.map((col) => (
        <nav aria-label={col.title}>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
      <div>
        <h2>Office</h2>
        <p class="office">{business.name}<br />{business.title}<br />{business.membershipNo}<br />{business.location}</p>
        <p class="office"><a href={`mailto:${business.email}`}>{business.email}</a><br /><a href={`tel:${business.phone}`}>{business.phoneDisplay}</a></p>
      </div>
    </div>
    <p class="compliance">{footer.compliance}</p>
    <p class="legal">© {year} {business.name} (Placeholder). Design-2 template v1.0.</p>
  </div>
</footer>

<style>
  .footer { background: var(--color-night); color: rgba(243, 237, 225, 0.72); padding: 88px 0 36px; }
  .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 28px; }
  .wordmark { margin: 0; font-family: var(--font-display); font-size: clamp(34px, 5vw, 58px); font-weight: 700; letter-spacing: -0.025em; color: #f3ede1; line-height: 1.05; }
  .tagline { margin: 14px 0 0; font-size: 15px; max-width: 48ch; }
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 56px; padding-top: 40px; border-top: 1px solid rgba(243, 237, 225, 0.14); }
  .cols h2 { margin: 0 0 16px; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; color: #d9bbae; }
  .cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .cols a { color: rgba(243, 237, 225, 0.78); text-decoration: none; font-size: 14.5px; }
  .cols a:hover { color: #fcfaf7; text-decoration: underline; text-underline-offset: 4px; }
  .office { font-size: 14.5px; line-height: 1.75; margin: 0 0 14px; }
  .compliance { font-size: 12.5px; color: rgba(243, 237, 225, 0.68); border-top: 1px solid rgba(243, 237, 225, 0.14); margin: 48px 0 0; padding-top: 22px; max-width: 90ch; }
  .legal { font-size: 12.5px; color: rgba(243, 237, 225, 0.6); margin: 10px 0 0; }
  @media (max-width: 767px) { .top { flex-direction: column; } .cols { grid-template-columns: 1fr; gap: 32px; } }
</style>
