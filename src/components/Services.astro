---
/**
 * SERVICES — neutral-50 background.
 * Three services, alternating left-right layout.
 * Space Mono large numbers. Real paragraph descriptions.
 * Stripe: 32px card padding, 12px radius, Level 1 shadow on white cards.
 */
const services = [
  {
    no: '01',
    title: 'Audit & Assurance',
    description:
      'Statutory, internal and tax audits executed to the standard CA Shahid practised at EY — planned risk-first, documented thoroughly, and closed with findings you can actually act on. For companies, trusts, societies and government-linked assignments, the audit is treated as a control upgrade, not a signature exercise: systems are tested, gaps are named plainly, and the management letter leaves you stronger than it found you. That Big Four discipline, sized for Vidarbha businesses that have never had access to it.',
    points: ['Statutory & tax audit', 'Internal & management audit', 'Stock & concurrent audit'],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3l9 4v5.5c0 5.5-4 9.2-9 11-5-1.8-9-5.5-9-11V7l9-4z"/><path d="M10 13.5l2.5 2.5 5.5-5.5"/></svg>`,
  },
  {
    no: '02',
    title: 'Regulatory Compliance',
    description:
      'Income tax, GST, TDS, ROC and RERA filings handled as an ongoing control calendar — nothing left to deadline panic. Returns are reconciled to books before filing, notices are answered with documented reasoning rather than rushed replies, and registrations are structured correctly from day one. With experience spanning MGNREGA internal audit for two districts and a published RERA paper, regulatory work here is proactive: you know what is due, what changed, and what it means for you, before the department asks.',
    points: ['Income Tax, GST & TDS', 'ROC & RERA filings', 'Notice handling & representation'],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="18" height="22" rx="1.5"/><path d="M9 9h10M9 13h10M9 17h6"/><path d="M17.5 18.5l1.5 1.5 3-3"/></svg>`,
  },
  {
    no: '03',
    title: 'Financial Advisory',
    description:
      'The part most local firms skip: sitting with you before the decision, not after. Business structuring, working-capital reviews, loan documentation, investment and tax-position planning — each grounded in audited numbers rather than optimism. Drawing on exposure to global technology clients and shipping, manufacturing and real-estate engagements, advice is given in plain language with the working papers to back it: what the options cost, what the risks are, and which path the numbers support.',
    points: ['Business structuring', 'Working capital & loan support', 'Tax-efficient investment planning'],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21l6.5-6.5 4 4L24 8"/><path d="M20 8h4v4"/></svg>`,
  },
];
---

<section id="services" class="services-section section-pad" aria-label="Services">
  <div class="container-xl">

    <header class="services-header">
      <p class="label-text services-eyebrow">Services · Three disciplines, done deeply</p>
      <h2 class="section-heading reveal">
        What the firm<br />takes responsibility for.
      </h2>
      <p class="services-lede">
        Fewer services than a general practice — deliberately. Each engagement
        gets partner-level attention and global-grade documentation.
      </p>
    </header>

    <ol class="services-list" role="list" data-stagger-group>
      {services.map((s, i) => (
        <li class={`service-row ${i % 2 === 1 ? 'service-row--flip' : ''}`} data-stagger-item>

          <!-- Large Space Mono number -->
          <div class="service-num-col" aria-hidden="true">
            <span class="service-no">{s.no}</span>
          </div>

          <!-- Content card — Stripe card-feature-light structure -->
          <div class="service-card card">
            <div class="service-card-header">
              <span class="service-icon" aria-hidden="true" set:html={s.icon} />
              <h3 class="service-title reveal">{s.title}</h3>
            </div>
            <p class="service-desc">{s.description}</p>
            <ul class="service-points" role="list">
              {s.points.map(p => <li>{p}</li>)}
            </ul>
            <a
              href={`https://wa.me/918087128040?text=Hi%20CA%20Shahid%2C%20I%20would%20like%20to%20discuss%20${encodeURIComponent(s.title)}.`}
              target="_blank"
              rel="noopener noreferrer"
              class="link-brass service-enquire"
              aria-label={`Enquire about ${s.title}`}
            >
              Enquire about this service →
            </a>
          </div>

        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .services-section { background: var(--color-neutral-50); }

  .services-header { margin-bottom: 64px; }
  .services-eyebrow { color: var(--color-accent-brass-dk); margin: 0 0 16px; display: block; }
  .services-header .section-heading { margin: 0 0 20px; }
  .services-lede {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-neutral-600);
    max-width: 480px;
    margin: 0;
  }

  /* Alternating rows */
  .services-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 40px; }

  .service-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 40px;
    align-items: start;
  }
  .service-row--flip {
    grid-template-columns: 1fr 120px;
  }
  .service-row--flip .service-num-col { order: 2; text-align: right; }
  .service-row--flip .service-card { order: 1; }

  /* Number watermark */
  .service-num-col { padding-top: 16px; }
  .service-no {
    font-family: var(--font-mono);
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 700;
    line-height: 1;
    color: var(--color-primary-indigo);
    opacity: 0.08;
    user-select: none;
    display: block;
  }

  /* Card — Stripe card-feature-light: white, 32px pad, 12px radius, shadow-1 */
  .service-card { background: var(--color-canvas); }

  .service-card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .service-icon { color: var(--color-accent-brass); display: flex; flex-shrink: 0; }

  .service-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-primary-indigo);
    margin: 0;
  }

  .service-desc {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-neutral-600);
    margin: 0 0 20px;
  }

  /* Stripe pill-tag-soft structure — adapted to indigo palette */
  .service-points {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .service-points li {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-secondary-mauve);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
    background: var(--color-neutral-50);
  }

  .service-enquire {
    font-size: 14px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .service-row,
    .service-row--flip {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .service-row--flip .service-num-col { order: 0; text-align: left; }
    .service-row--flip .service-card { order: 1; }
    .service-num-col { padding-top: 0; padding-bottom: 4px; }
    .service-no { font-size: 40px; opacity: 0.12; }
  }
</style>
