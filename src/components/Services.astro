---
const services = [
  {
    no: '01',
    title: 'Real Estate Transactions',
    description:
      'Counsel for property purchases, sales, agreements, and other real estate transactions where careful review and clear legal guidance matter — before signatures create problems.',
    points: ['Purchase & sale counsel', 'Agreement review', 'Transaction guidance'],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 24V12l10-8 10 8v12"/><path d="M10 24v-7h8v7"/><path d="M4 12h20"/></svg>`,
  },
  {
    no: '02',
    title: 'Real Estate Disputes',
    description:
      'Representation and counsel concerning disagreements involving property rights, contracts, ownership, and related real estate conflicts — assessed practically, pursued deliberately.',
    points: ['Property-rights conflicts', 'Contract disputes', 'Ownership disagreements'],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v10"/><path d="M6 7h16"/><path d="M6 7l-3 7a4 4 0 007 0L7 7"/><path d="M22 7l-3 7a4 4 0 007 0l-3-7"/><path d="M11 21h6"/></svg>`,
  },
  {
    no: '03',
    title: 'Boundary & Neighbor Disputes',
    description:
      'Legal guidance for disputes involving property boundaries, neighboring owners, and competing claims over the use or rights associated with property.',
    points: ['Boundary questions', 'Neighbor conflicts', 'Use & access claims'],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l20 20" stroke-dasharray="3 3"/><path d="M9 9H4v16h16v-5"/><path d="M19 19h5V4H9"/></svg>`,
  },
  {
    no: '04',
    title: 'Co-Ownership Disputes',
    description:
      'Counsel for disagreements between co-owners concerning ownership interests, use, management, sale, or division of property.',
    points: ['Ownership interests', 'Use & management', 'Sale or division'],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="10" r="5"/><circle cx="18" cy="18" r="5"/><path d="M14 6l8 16"/></svg>`,
  },
  {
    no: '05',
    title: 'Landlord–Tenant Matters',
    description:
      'Legal assistance involving disputes and other real estate issues between landlords and tenants — grounded in the lease, the facts, and the objective.',
    points: ['Lease disputes', 'Possession & use issues', 'Landlord–tenant guidance'],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11l10-7 10 7"/><path d="M6 9v12h16V9"/><path d="M12 21v-5h4v5"/></svg>`,
  },
  {
    no: '06',
    title: 'Purchase & Sale Disputes',
    description:
      'Advice and representation when a real estate transaction develops into a dispute involving contracts, representations, disclosure, or performance.',
    points: ['Contract performance', 'Disclosure questions', 'Failed closings'],
    icon: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="18" height="22" rx="1.5"/><path d="M9 9h10M9 13h10M9 17h6"/></svg>`,
  },
];
---

<section id="practice-areas" class="services-section section-pad" aria-label="Practice areas">
  <div class="container-xl">

    <header class="services-header">
      <p class="label-text services-eyebrow">Practice Areas · Real estate, handled precisely</p>
      <h2 class="section-heading reveal">
        What the practice<br />takes responsibility for.
      </h2>
      <p class="services-lede">
        Six areas, one focus: property matters where the documents, the
        interests, and the stakes all deserve close attention.
      </p>
    </header>

    <ol class="services-list" role="list" data-stagger-group>
      {services.map((s, i) => (
        <li class={`service-row ${i % 2 === 1 ? 'service-row--flip' : ''}`} data-stagger-item>

          <div class="service-num-col" aria-hidden="true">
            <span class="service-no">{s.no}</span>
          </div>

          <div class="service-card card">
            <div class="service-card-header">
              <span class="service-icon" aria-hidden="true" set:html={s.icon} />
              <h3 class="service-title reveal">{s.title}</h3>
            </div>
            <p class="service-desc">{s.description}</p>
            <ul class="service-points" role="list">
              {s.points.map(p => <li>{p}</li>)}
            </ul>
            <a
              href="#contact"
              class="link-brass service-enquire"
              aria-label={`Discuss ${s.title}`}
            >
              Discuss this matter →
            </a>
          </div>

        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .services-section { background: var(--color-neutral-50); }

  .services-header { margin-bottom: 64px; }
  .services-eyebrow { color: var(--color-accent-brass-dk); margin: 0 0 16px; display: block; }
  .services-header .section-heading { margin: 0 0 20px; }
  .services-lede {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-neutral-600);
    max-width: 480px;
    margin: 0;
  }

  .services-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 40px; }

  .service-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 40px;
    align-items: start;
  }
  .service-row--flip {
    grid-template-columns: 1fr 120px;
  }
  .service-row--flip .service-num-col { order: 2; text-align: right; }
  .service-row--flip .service-card { order: 1; }

  .service-num-col { padding-top: 16px; }
  .service-no {
    font-family: var(--font-mono);
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 700;
    line-height: 1;
    color: var(--color-primary-indigo);
    opacity: 0.08;
    user-select: none;
    display: block;
  }

  .service-card { background: var(--color-canvas); }

  .service-card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .service-icon { color: var(--color-accent-brass); display: flex; flex-shrink: 0; }

  .service-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-primary-indigo);
    margin: 0;
  }

  .service-desc {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-neutral-600);
    margin: 0 0 20px;
  }

  .service-points {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .service-points li {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-secondary-mauve);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
    background: var(--color-neutral-50);
  }

  .service-enquire {
    font-size: 14px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .service-row,
    .service-row--flip {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .service-row--flip .service-num-col { order: 0; text-align: left; }
    .service-row--flip .service-card { order: 1; }
    .service-num-col { padding-top: 0; padding-bottom: 4px; }
    .service-no { font-size: 40px; opacity: 0.12; }
  }
</style>
