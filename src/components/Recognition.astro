---
const entries = [
  {
    no: '01',
    title: 'The contract is no longer straightforward',
    context:
      'A purchase, sale, or agreement that looked routine now turns on language, timing, disclosure, or performance — and the next step is not obvious.',
  },
  {
    no: '02',
    title: 'Ownership interests are in conflict',
    context:
      'Co-owners disagree about use, management, sale, or division, and the property itself becomes the pressure point.',
  },
  {
    no: '03',
    title: 'A boundary or neighboring-property dispute escalates',
    context:
      'A fence line, an encroachment, or a competing claim over use becomes a legal question that neighborly discussion alone cannot settle.',
  },
  {
    no: '04',
    title: 'A transaction develops into a legal dispute',
    context:
      'Representations, conditions, or obligations are disputed after the deal moves forward — and the documents now matter more than the handshake.',
  },
  {
    no: '05',
    title: 'Negotiation may be better than litigation',
    context:
      'Not every property fight belongs in court. Sometimes the right move is a clear-eyed settlement pursued before positions harden.',
  },
];
---

<section id="why-counsel" class="recognition-section section-pad" aria-label="When to seek real estate counsel">
  <div class="container-xl">

    <div class="rec-layout">

      <div class="rec-intro">
        <p class="label-text rec-eyebrow">Relevance · Real client problems</p>
        <h2 class="section-heading on-dark reveal">
          When the property<br />is more complicated<br />than it looks.
        </h2>
        <p class="rec-lede">
          Most clients arrive with one of these situations. If yours looks
          familiar, a conversation about the documents and the objective is
          the right place to start.
        </p>
        <a
          href="#contact"
          class="btn-secondary on-dark"
          aria-label="Request a consultation about your property matter"
        >
          Request a Consultation
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <ol class="rec-list" role="list" aria-label="Situations where real estate counsel helps" data-stagger-group>
        {entries.map((e, i) => (
          <li class="rec-entry" data-stagger-item>
            {i > 0 && <div class="rec-divider" aria-hidden="true"></div>}
            <div class="rec-entry-inner">
              <span
                class="rec-year reveal"
                aria-hidden="true"
              >
                {e.no}
              </span>
              <div class="rec-content">
                <h3 class="rec-title">{e.title}</h3>
                <p class="rec-context">{e.context}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>

    </div>
  </div>
</section>

<style>
  .recognition-section { background: var(--color-primary-indigo); }

  .rec-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 80px;
    align-items: start;
  }

  .rec-eyebrow { color: var(--color-accent-brass-lt); margin: 0 0 20px; display: block; }
  .rec-intro .section-heading { margin: 0 0 20px; }
  .rec-lede {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-on-dark-muted);
    margin: 0 0 32px;
  }
  .rec-intro { position: sticky; top: 100px; }

  .rec-list { list-style: none; margin: 0; padding: 0; }
  .rec-entry { margin: 0; }

  .rec-divider {
    height: 1px;
    background: rgba(255,255,255,0.10);
    margin: 0;
  }

  .rec-entry-inner {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 24px;
    padding: 40px 0;
    align-items: start;
  }

  .rec-year {
    font-family: var(--font-mono);
    font-size: clamp(26px, 2.8vw, 36px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-accent-brass-lt);
    white-space: nowrap;
    padding-top: 4px;
    display: block;
    font-feature-settings: "tnum";
  }

  .rec-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-on-dark);
    margin: 0 0 10px;
  }

  .rec-context {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-on-dark-muted);
    margin: 0;
  }

  @media (max-width: 900px) {
    .rec-layout { grid-template-columns: 1fr; gap: 48px; }
    .rec-intro { position: static; }
    .rec-lede { max-width: 560px; }
  }
  @media (max-width: 600px) {
    .rec-entry-inner { grid-template-columns: 80px 1fr; gap: 16px; padding: 32px 0; }
    .rec-year { font-size: 22px; }
  }
  @media (max-width: 360px) {
    .rec-entry-inner { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
